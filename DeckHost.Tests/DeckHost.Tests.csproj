<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
  </ItemGroup>

  <!-- SkiaSharp brings its Windows and macOS natives itself; this lets the rendering tests run on Linux too. -->
  <ItemGroup Condition="$([MSBuild]::IsOsPlatform('Linux'))">
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
    <ProjectReference Include="..\DeckHost.Core\DeckHost.Core.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Elgato\DeckHost.Device.Elgato.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Hid\DeckHost.Device.Hid.csproj" />
    <ProjectReference Include="..\DeckHost.Device.MiraBox\DeckHost.Device.MiraBox.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Web\DeckHost.Device.Web.csproj" />
    <!-- For the platform code's pure parts (tool output parsing, key tables, sign-in entries). -->
    <ProjectReference Include="..\DeckHost.App\DeckHost.App.csproj" />
    <!-- Only built so the plugin catalog tests can install its package. -->
    <ProjectReference Include="..\plugins\DeckHost.Plugin.Obs\DeckHost.Plugin.Obs.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

</Project>
