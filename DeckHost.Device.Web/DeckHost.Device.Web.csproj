<Project Sdk="Microsoft.NET.Sdk">
  <!-- A deck in a browser: phones and tablets on the network, or a window on this computer. -->
  <PropertyGroup>
    <!-- Ships as a plugin package under plugins/bundled (build/BundledDevicePlugin.targets). -->
    <BundledPluginId>deckhost.device.web</BundledPluginId>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeckHost.Tests" />
    <EmbeddedResource Include="deck.html" LogicalName="deck.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="4.151.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
  </ItemGroup>

  <Import Project="..\build\BundledDevicePlugin.targets" />
</Project>
