<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Ships as a plugin package under plugins/bundled, with its native bridge (build/BundledDevicePlugin.targets). -->
    <BundledPluginId>deckhost.device.mirabox</BundledPluginId>
    <EnableMiraBoxNativeBuild Condition="'$(EnableMiraBoxNativeBuild)' == ''">true</EnableMiraBoxNativeBuild>
    <IsWindows>$([MSBuild]::IsOsPlatform('Windows'))</IsWindows>
    <IsLinux>$([MSBuild]::IsOsPlatform('Linux'))</IsLinux>
    <IsMacOS>$([MSBuild]::IsOsPlatform('OSX'))</IsMacOS>
    <IsSupportedMiraBoxBuildPlatform Condition="'$(IsWindows)' == 'true' or '$(IsLinux)' == 'true' or '$(IsMacOS)' == 'true'">true</IsSupportedMiraBoxBuildPlatform>
    <CMakeExePath Condition="'$(CMakeExePath)' == '' and '$(IsWindows)' == 'true' and '$(DevEnvDir)' != '' and Exists('$(DevEnvDir)CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(DevEnvDir)CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExePath>
    <CMakeExePath Condition="'$(CMakeExePath)' == '' and '$(IsWindows)' == 'true' and '$(VSInstallDir)' != '' and Exists('$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe')">$(VSInstallDir)Common7\IDE\CommonExtensions\Microsoft\CMake\CMake\bin\cmake.exe</CMakeExePath>
    <CMakeCommand Condition="'$(CMakeExePath)' != ''">&quot;$(CMakeExePath)&quot;</CMakeCommand>
    <CMakeCommand Condition="'$(CMakeCommand)' == ''">cmake</CMakeCommand>
    <HasCMake>false</HasCMake>
    <NativeBridgeProjectDir>$(MSBuildProjectDirectory)/../native/MiraBoxBridge</NativeBridgeProjectDir>
    <NativeBridgeBuildDir>$(NativeBridgeProjectDir)/out/$(Configuration)</NativeBridgeBuildDir>
    <NativeBridgeRuntimeDir>$(NativeBridgeBuildDir)/bin/$(Configuration)</NativeBridgeRuntimeDir>
    <NativeBridgeConfigureStamp>$(NativeBridgeBuildDir)/CMakeCache.txt</NativeBridgeConfigureStamp>
    <NativeBridgeBuildStamp>$(NativeBridgeBuildDir)/MiraBoxBridge.$(Configuration).stamp</NativeBridgeBuildStamp>
    <StreamDockSdkDir>$(MSBuildProjectDirectory)/../native/StreamDock-SDK</StreamDockSdkDir>
    <StreamDockSdkPatch>$(MSBuildProjectDirectory)/../native/patches/streamdock-sdk.patch</StreamDockSdkPatch>
    <!-- Extra CMake arguments for the bridge, e.g. -DOpenCV_DIR=... for a static OpenCV on Linux
         (scripts/build-opencv-static.sh). -->
    <MiraBoxCMakeArgs Condition="'$(MiraBoxCMakeArgs)' == ''"></MiraBoxCMakeArgs>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeckHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <NativeBridgeConfigureInputs Include="$(NativeBridgeProjectDir)/CMakeLists.txt" />
    <NativeBridgeConfigureInputs Include="$(MSBuildProjectDirectory)/../native/StreamDock-SDK/CPP-SDK/CMakeLists.txt" />
    <NativeBridgeConfigureInputs Include="$(MSBuildProjectDirectory)/../native/StreamDock-SDK/CPP-SDK/cmake/**/*" />
    <NativeBridgeInputs Include="$(NativeBridgeProjectDir)/**/*" Exclude="$(NativeBridgeProjectDir)/out/**/*" />
    <NativeBridgeInputs Include="$(MSBuildProjectDirectory)/../native/StreamDock-SDK/CPP-SDK/**/*" Exclude="$(MSBuildProjectDirectory)/../native/StreamDock-SDK/CPP-SDK/build/**/*" />
  </ItemGroup>

  <Target Name="DetectCMake"
          BeforeTargets="ConfigureMiraBoxBridge"
          Condition="'$(IsSupportedMiraBoxBuildPlatform)' == 'true' and '$(EnableMiraBoxNativeBuild)' == 'true'">
    <Exec Command="$(CMakeCommand) --version"
          IgnoreExitCode="true"
          ConsoleToMSBuild="true">
      <Output TaskParameter="ExitCode" PropertyName="CMakeExitCode" />
    </Exec>

    <PropertyGroup>
      <HasCMake Condition="'$(CMakeExitCode)' == '0'">true</HasCMake>
    </PropertyGroup>

    <Warning Text="Skipping MiraBox native bridge build because CMake could not be found. Set CMakeExePath, use Visual Studio's bundled CMake on Windows, or install CMake on PATH to build and copy MiraBoxBridge runtime binaries."
             Condition="'$(HasCMake)' != 'true'" />
  </Target>

  <!-- The StreamDock SDK submodule is pinned to an upstream commit; our local fixes live in a patch
       that is applied here (idempotently) so a fresh recursive clone builds without manual steps. -->
  <Target Name="ApplyStreamDockSdkPatch"
          BeforeTargets="ConfigureMiraBoxBridge"
          Condition="'$(IsSupportedMiraBoxBuildPlatform)' == 'true' and '$(EnableMiraBoxNativeBuild)' == 'true' and '$(HasCMake)' == 'true' and Exists('$(StreamDockSdkPatch)') and Exists('$(StreamDockSdkDir)/CPP-SDK/CMakeLists.txt')">
    <Exec Command="git -C &quot;$(StreamDockSdkDir)&quot; apply --reverse --check --ignore-whitespace &quot;$(StreamDockSdkPatch)&quot;"
          IgnoreExitCode="true"
          IgnoreStandardErrorWarningFormat="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low"
          EchoOff="true">
      <Output TaskParameter="ExitCode" PropertyName="StreamDockSdkPatchReverseCheck" />
    </Exec>
    <Exec Command="git -C &quot;$(StreamDockSdkDir)&quot; apply --ignore-whitespace &quot;$(StreamDockSdkPatch)&quot;"
          Condition="'$(StreamDockSdkPatchReverseCheck)' != '0'" />
  </Target>

  <Target Name="ConfigureMiraBoxBridge"
          BeforeTargets="Build"
          Inputs="@(NativeBridgeConfigureInputs)"
          Outputs="$(NativeBridgeConfigureStamp)"
          Condition="'$(IsSupportedMiraBoxBuildPlatform)' == 'true' and '$(EnableMiraBoxNativeBuild)' == 'true' and '$(HasCMake)' == 'true'">
    <MakeDir Directories="$(NativeBridgeBuildDir)" />
    <Exec Command="$(CMakeCommand) -S &quot;$(NativeBridgeProjectDir)&quot; -B &quot;$(NativeBridgeBuildDir)&quot; -DCMAKE_BUILD_TYPE=$(Configuration) $(MiraBoxCMakeArgs)" />
  </Target>

  <Target Name="BuildMiraBoxBridge"
          DependsOnTargets="ConfigureMiraBoxBridge"
          BeforeTargets="Build"
          Inputs="@(NativeBridgeInputs);$(NativeBridgeConfigureStamp)"
          Outputs="$(NativeBridgeBuildStamp)"
          Condition="'$(IsSupportedMiraBoxBuildPlatform)' == 'true' and '$(EnableMiraBoxNativeBuild)' == 'true' and '$(HasCMake)' == 'true'">
    <Exec Command="$(CMakeCommand) --build &quot;$(NativeBridgeBuildDir)&quot; --config $(Configuration) --target MiraBoxBridge" />
    <Touch Files="$(NativeBridgeBuildStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="CopyMiraBoxBridgeArtifacts"
          DependsOnTargets="BuildMiraBoxBridge"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(IsSupportedMiraBoxBuildPlatform)' == 'true' and '$(EnableMiraBoxNativeBuild)' == 'true' and '$(HasCMake)' == 'true'">
    <ItemGroup>
      <NativeBridgeArtifacts Include="$(NativeBridgeRuntimeDir)/*.dll" Condition="'$(IsWindows)' == 'true'" />
      <NativeBridgeArtifacts Include="$(NativeBridgeRuntimeDir)/*.pdb" Condition="'$(IsWindows)' == 'true' and '$(Configuration)' == 'Debug'" />
      <NativeBridgeArtifacts Include="$(NativeBridgeRuntimeDir)/*.so" Condition="'$(IsLinux)' == 'true'" />
      <NativeBridgeArtifacts Include="$(NativeBridgeRuntimeDir)/*.dylib" Condition="'$(IsMacOS)' == 'true'" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeBridgeArtifacts)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          />
  </Target>

  <!-- The bundled package carries the native bridge (and on Linux/macOS its transport and OpenCV libraries).
       Read from the native output after Build (the bridge is built just before Build, after the copy to OutDir). -->
  <Target Name="CollectMiraBoxBundleFiles" BeforeTargets="BundleDevicePlugin" Condition="Exists('$(NativeBridgeRuntimeDir)')">
    <ItemGroup>
      <BundledPluginExtraFile Include="$(NativeBridgeRuntimeDir)/*.dll" Condition="'$(IsWindows)' == 'true'" />
      <BundledPluginExtraFile Include="$(NativeBridgeRuntimeDir)/*.pdb" Condition="'$(IsWindows)' == 'true' and '$(Configuration)' == 'Debug'" />
      <BundledPluginExtraFile Include="$(NativeBridgeRuntimeDir)/*.so" Condition="'$(IsLinux)' == 'true'" />
      <BundledPluginExtraFile Include="$(NativeBridgeRuntimeDir)/*.dylib" Condition="'$(IsMacOS)' == 'true'" />
    </ItemGroup>
  </Target>

  <Import Project="..\build\BundledDevicePlugin.targets" />

</Project>
