{
  // The most DeckHost may take, per run of benchmarks/DeckHost.Benchmark (docs/performance.md).
  // "default" applies everywhere; "windows", "linux" and "macos" override single limits.
  // CPU is % of one core, memory the working set in MB of every DeckHost process together.
  // A pull request fails when a number goes over its limit; raising one is a reviewed change here.
  "default": {
    "startup.firstFrameSeconds": 10,
    "idleWindow.cpuPercent": 2,
    "idleWindow.memoryMb": 300,
    "idleTray.cpuPercent": 1,
    "idleTray.memoryMb": 300,
    "busy.cpuPercent": 25,
    "busy.memoryMaxMb": 350,
    "busy.memoryGrowthMb": 30,
    "latency.p95Ms": 100
  }
}
