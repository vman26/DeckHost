<Project Sdk="Microsoft.NET.Sdk">
  <!-- Measures a published DeckHost from outside: start-up, idle (window and tray), busy and
       press-to-image latency through the device simulator. See docs/performance.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeckHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
    <ProjectReference Include="..\..\DeckHost.Core\DeckHost.Core.csproj" />
    <ProjectReference Include="..\..\DeckHost.Device.Simulator\DeckHost.Device.Simulator.csproj" />
  </ItemGroup>
</Project>
