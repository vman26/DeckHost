<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The dotnet new templates for DeckHost plugins:
      dotnet new install DeckHost.Templates
      dotnet new deckhost-plugin -n MyPlugin
    Packed and published with each release (release.yml), next to DeckHost.Contracts.
  -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>DeckHost.Templates</PackageId>
    <Title>DeckHost plugin templates</Title>
    <Description>dotnet new templates for DeckHost plugins: dotnet new deckhost-plugin.</Description>
    <PackageTags>deckhost;plugin;template;dotnet-new;streamdeck</PackageTags>
    <PackageProjectUrl>https://vman26.github.io/DeckHost/maintainers/plugins/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/vman26/DeckHost</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
