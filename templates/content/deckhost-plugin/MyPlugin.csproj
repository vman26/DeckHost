<Project Sdk="Microsoft.NET.Sdk">

  <!-- A DeckHost plugin. "dotnet build" also writes bin/plugin/you.plugin.example.zip, which you
       install in DeckHost (Plugins → Install plugin…) or publish (see README.md). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <PluginId>you.plugin.example</PluginId>
    <PluginPackageDirectory>$(MSBuildThisFileDirectory)bin\plugin\</PluginPackageDirectory>
  </PropertyGroup>

  <!-- DeckHost supplies DeckHost.Contracts at run time: never ship a copy inside the package.
       Pin the version you test with (the oldest DeckHost your plugin needs). -->
  <ItemGroup>
    <PackageReference Include="DeckHost.Contracts" Version="CONTRACTS_VERSION" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="README.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="PackPluginPackage" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <PluginStagingDirectory>$(IntermediateOutputPath)package\</PluginStagingDirectory>
      <PluginPackagePath>$(PluginPackageDirectory)$(PluginId).zip</PluginPackagePath>
    </PropertyGroup>
    <RemoveDir Directories="$(PluginStagingDirectory)" />
    <Copy SourceFiles="$(TargetPath);$(OutDir)plugin.json;$(OutDir)README.md" DestinationFolder="$(PluginStagingDirectory)" />
    <MakeDir Directories="$(PluginPackageDirectory)" />
    <ZipDirectory SourceDirectory="$(PluginStagingDirectory)" DestinationFile="$(PluginPackagePath)" Overwrite="true" />
    <Message Importance="high" Text="Plugin package: $(PluginPackagePath)" />
  </Target>

</Project>
