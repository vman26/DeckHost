<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generic USB HID devices (button boxes, foot pedals, jog wheels, macro pads with a readable
       HID interface) described by the user in the device creator. HidSharp: Windows, Linux hidraw,
       macOS IOKit. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeckHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
  </ItemGroup>
</Project>
