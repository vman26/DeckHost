# MiraBox / StreamDock devices (the USB ids of every model in the vendor SDK): give the person
# signed in at the computer access to the device, so DeckHost can run without root. "uaccess"
# (systemd-logind) grants it to the active session only, unlike the SDK's sample rule, which makes
# the device writable for every user. The number must stay below 73, where systemd applies uaccess.
# N4 Pro
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="5548", ATTRS{idProduct}=="1008", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="5548", ATTR{idProduct}=="1008", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="5548", ATTRS{idProduct}=="1021", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="5548", ATTR{idProduct}=="1021", TAG+="uaccess"
# N4
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6602", ATTRS{idProduct}=="1001", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="6602", ATTR{idProduct}=="1001", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="6603", ATTRS{idProduct}=="1007", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="6603", ATTR{idProduct}=="1007", TAG+="uaccess"
# 293 V2
