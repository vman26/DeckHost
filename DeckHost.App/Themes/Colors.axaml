                <SolidColorBrush x:Key="C.1E3A8A" Color="#DBEAFE" />
                <SolidColorBrush x:Key="C.262B36" Color="#CBD5E1" />
                <SolidColorBrush x:Key="C.2A1215" Color="#FEF2F2" />
                <SolidColorBrush x:Key="C.2D2D2D" Color="#E5E7EB" />
                <SolidColorBrush x:Key="C.334155" Color="#CBD5E1" />
                <SolidColorBrush x:Key="C.3B82F6" Color="#3B82F6" />
                <SolidColorBrush x:Key="C.475569" Color="#94A3B8" />
                <SolidColorBrush x:Key="C.64748B" Color="#64748B" />
                <SolidColorBrush x:Key="C.66FFFFFF" Color="#66000000" />
                <SolidColorBrush x:Key="C.99000000" Color="#66000000" />
                <SolidColorBrush x:Key="C.7F1D1D" Color="#FEE2E2" />
                <SolidColorBrush x:Key="C.93C5FD" Color="#1D4ED8" />
                <SolidColorBrush x:Key="C.94A3B8" Color="#475569" />
                <SolidColorBrush x:Key="C.BBF7D0" Color="#15803D" />
                <SolidColorBrush x:Key="C.BFDBFE" Color="#1E40AF" />
                <SolidColorBrush x:Key="C.CBD5E1" Color="#334155" />
                <SolidColorBrush x:Key="C.DBEAFE" Color="#1E3A8A" />
