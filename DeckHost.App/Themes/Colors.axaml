                <SolidColorBrush x:Key="C.F8FAFC" Color="#0F172A" />
                <SolidColorBrush x:Key="C.FBBF24" Color="#B45309" />
                <SolidColorBrush x:Key="C.FCA5A5" Color="#B91C1C" />
                <SolidColorBrush x:Key="C.FCD34D" Color="#B45309" />
                <SolidColorBrush x:Key="C.FDE68A" Color="#A16207" />
                <SolidColorBrush x:Key="C.FECACA" Color="#991B1B" />
                <SolidColorBrush x:Key="C.FFFFFF" Color="#FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
