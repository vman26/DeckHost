<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		x:Class="DeckHost.App.Views.SupportView"
		x:DataType="vm:SupportViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.title">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.E2E8F0}" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="20" Spacing="14">

			<!-- After a crash: what happened and what to do (nothing was sent). -->
			<Border IsVisible="{Binding HasNewCrashes}" Background="{DynamicResource C.2A1215}" BorderBrush="{DynamicResource C.7F1D1D}" BorderThickness="1" CornerRadius="12" Padding="14">
				<StackPanel Spacing="8">
					<TextBlock Text="{Binding NewCrashTitle}" FontWeight="SemiBold" Foreground="{DynamicResource C.FECACA}" TextWrapping="Wrap" />
					<TextBlock Classes="hint" Foreground="{DynamicResource C.FCA5A5}"
							   Text="A crash report was saved on this computer; nothing was sent. Reporting it helps fix it: it opens a GitHub issue with the report filled in, which you can read and change before you submit it." />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Content="Report it" Classes="accent" Command="{Binding ReportNewestCommand}" />
						<Button Content="Save support bundle…" Click="SaveBundle_OnClick" />
						<Button Content="Not now" Command="{Binding MarkSeenCommand}" />
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="10">
					<TextBlock Classes="title" Text="Documentation" />
					<TextBlock Classes="hint" Text="Getting started, devices, profiles, pages and folders, workflows, plugins and troubleshooting." />
					<StackPanel Orientation="Horizontal" Spacing="10">
						<Button Content="Open the documentation" Classes="accent" Command="{Binding OpenDocumentationCommand}" />
						<SelectableTextBlock Text="{x:Static vm:SupportViewModel.DocumentationUrl}" Foreground="{DynamicResource C.94A3B8}" VerticalAlignment="Center" />
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Classes="card" IsVisible="{Binding HasDeviceDiagnostics}">
				<StackPanel Spacing="8">
					<TextBlock Classes="title" Text="Devices" />
					<TextBlock Classes="hint" Text="What DeckHost has seen of each device since it started. Press a key and refresh: if the inputs don't go up, the device isn't reaching DeckHost (another program has it, a missing Linux rule, the cable)." />
					<ItemsControl ItemsSource="{Binding DeviceDiagnostics}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<SelectableTextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" Margin="0,2" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<Button Content="Refresh" Command="{Binding RefreshDiagnosticsCommand}" />
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="10">
					<TextBlock Classes="title" Text="Report a problem" />
					<TextBlock Classes="hint" Text="Opens a new GitHub issue with DeckHost's version, your system and your devices filled in. Describe what happened; attaching a support bundle helps." />
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Content="Report a problem" Command="{Binding ReportProblemCommand}" />
						<Button Content="Save support bundle…" Click="SaveBundle_OnClick" />
						<Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
					</StackPanel>
					<CheckBox Content="Put my profiles in the bundle" IsChecked="{Binding IncludeProfiles}" />
					<TextBlock Classes="hint" Text="The bundle holds the logs of the last days, crash reports, settings and the plugin list; your home folder and user name are replaced. Profiles are left out unless you tick this: actions keep passwords (OBS, for example) in them." />
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="10">
					<TextBlock Classes="title" Text="Crash reports" />
					<CheckBox Content="After a crash, offer to report it when DeckHost starts" IsChecked="{Binding OfferCrashReports}" />
					<TextBlock Classes="hint" Text="DeckHost never sends anything by itself. Crash reports stay in the crashes folder until you report them." />
					<TextBlock Classes="hint" Text="No crashes so far." IsVisible="{Binding !HasCrashes}" />
					<ItemsControl ItemsSource="{Binding Crashes}" IsVisible="{Binding HasCrashes}">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:CrashItemViewModel">
								<Border Background="{DynamicResource C.111827}" CornerRadius="8" Padding="10,6">
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
										<StackPanel Spacing="2">
											<TextBlock Text="{Binding When}" Foreground="{DynamicResource C.E2E8F0}" />
											<TextBlock Text="{Binding Headline}" FontSize="11" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
										</StackPanel>
										<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
											<Button Content="Open" Command="{Binding OpenCommand}" />
											<Button Content="Report" Command="{Binding ReportItCommand}" />
										</StackPanel>
									</Grid>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="4">
					<TextBlock Classes="title" Text="This DeckHost" />
					<SelectableTextBlock Text="{Binding Version}" Foreground="{DynamicResource C.CBD5E1}" />
					<SelectableTextBlock Text="{Binding SystemDescription}" Foreground="{DynamicResource C.94A3B8}" FontSize="12" TextWrapping="Wrap" />
				</StackPanel>
			</Border>

			<TextBlock Text="{Binding Status}" Foreground="{DynamicResource C.93C5FD}" TextWrapping="Wrap" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
