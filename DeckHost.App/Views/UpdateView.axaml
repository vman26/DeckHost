<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:views="using:DeckHost.App.Views"
		x:Class="DeckHost.App.Views.UpdateView"
		x:DataType="vm:UpdateViewModel">

	<Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="14">
		<StackPanel Spacing="4">
			<TextBlock Text="{Binding AvailableTitle}" IsVisible="{Binding IsUpdateAvailable}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
			<TextBlock Text="DeckHost is up to date" IsVisible="{Binding !IsUpdateAvailable}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
			<TextBlock Text="{Binding AvailableSummary}" IsVisible="{Binding IsUpdateAvailable}" Foreground="{DynamicResource C.94A3B8}" />
			<TextBlock Text="{Binding Status}" IsVisible="{Binding !IsUpdateAvailable}" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
		</StackPanel>

		<Border Grid.Row="1" Background="{DynamicResource C.0F172A}" BorderBrush="{DynamicResource C.1E293B}" BorderThickness="1" CornerRadius="12" IsVisible="{Binding IsUpdateAvailable}">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="16,12">
				<StackPanel Spacing="8">
					<TextBlock Text="What's new" FontWeight="SemiBold" Foreground="{DynamicResource C.94A3B8}" FontSize="13" />
					<views:MarkdownView Markdown="{Binding Changelog}" />
				</StackPanel>
			</ScrollViewer>
		</Border>

		<StackPanel Grid.Row="2" Spacing="10">
			<StackPanel Spacing="4" IsVisible="{Binding IsInstalling}">
				<ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}" />
				<TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="{DynamicResource C.93C5FD}" />
			</StackPanel>
			<TextBlock Text="{Binding InstallHint}" IsVisible="{Binding IsUpdateAvailable}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
			<TextBlock Text="{Binding Status}" IsVisible="{Binding IsUpdateAvailable}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
			<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="Release page" Command="{Binding OpenReleasePageCommand}" />
					<Button Content="Skip this version" Command="{Binding SkipCommand}" IsVisible="{Binding IsUpdateAvailable}" IsEnabled="{Binding !IsInstalling}" />
				</StackPanel>
				<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
					<Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}" />
					<Button Content="Later" Click="Later_OnClick" IsVisible="{Binding !IsInstalling}" />
					<Button Content="{Binding InstallLabel}" Classes="accent" Command="{Binding InstallCommand}" IsVisible="{Binding IsUpdateAvailable}" />
				</StackPanel>
			</Grid>
		</StackPanel>
	</Grid>
</UserControl>
