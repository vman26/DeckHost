<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:local="using:DeckHost.App.Views"
		x:Class="DeckHost.App.Views.DeviceSettingsView"
		x:DataType="vm:DeviceSettingsViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.label">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="#E2E8F0" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="#94A3B8" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.error">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="#FCA5A5" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="#0F172A" />
			<Setter Property="BorderBrush" Value="#1E293B" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
	</UserControl.Styles>

	<UserControl.DataTemplates>
		<DataTemplate DataType="vm:TextSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:NumberSettingField">
			<local:NumberSettingEditor />
		</DataTemplate>
		<DataTemplate DataType="vm:ToggleSettingField">
			<StackPanel Spacing="4">
				<CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:ChoiceSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<ComboBox ItemsSource="{Binding Options}"
						  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
						  HorizontalAlignment="Stretch"
						  DisplayMemberBinding="{Binding Label}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:FilePathSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" />
					<Button Grid.Column="1" Content="Browse…" Click="BrowseFile_OnClick" />
				</Grid>
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:SettingsEditorViewModel">
			<ItemsControl ItemsSource="{Binding Fields}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="14" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
			</ItemsControl>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid RowDefinitions="Auto,*,Auto">
		<Border Padding="20,16" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
			<StackPanel Spacing="4">
				<TextBlock Text="{Binding DeviceName}" FontSize="22" FontWeight="SemiBold" Foreground="#F8FAFC" />
				<TextBlock Text="{Binding ConnectionText}" Foreground="#94A3B8" TextWrapping="Wrap" />
			</StackPanel>
		</Border>

		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="20" Spacing="12">
				<Border Classes="card">
					<ContentControl Content="{Binding Editor}" />
				</Border>
				<!-- DeckHost's own default for the LEDs (applies right away, saved with the profiles). -->
				<Border Classes="card" IsVisible="{Binding HasLights}">
					<StackPanel Spacing="10" DataContext="{Binding Lights}" x:DataType="vm:KnobLightsViewModel">
						<TextBlock Text="Knob lights" FontWeight="SemiBold" FontSize="15" Foreground="#F1F5F9" />
						<TextBlock Classes="hint" Text="What the LEDs show while idle, in every profile. A knob can have a light of its own in Customize → Light. Changes show right away." />
						<CheckBox Content="Each knob its own effect" IsChecked="{Binding EachLedOwn}" IsVisible="{Binding CanEachLedOwn}" />
						<Panel IsVisible="{Binding ShowSharedEditor}">
							<local:LightStyleEditor DataContext="{Binding Editor}" />
						</Panel>
						<TabControl ItemsSource="{Binding Leds}" IsVisible="{Binding EachLedOwn}" Padding="0,8,0,0">
							<TabControl.ItemTemplate>
								<DataTemplate x:DataType="vm:LedLightViewModel">
									<TextBlock Text="{Binding Name}" FontSize="14" />
								</DataTemplate>
							</TabControl.ItemTemplate>
							<TabControl.ContentTemplate>
								<DataTemplate x:DataType="vm:LedLightViewModel">
									<local:LightStyleEditor DataContext="{Binding Editor}" />
								</DataTemplate>
							</TabControl.ContentTemplate>
						</TabControl>
					</StackPanel>
				</Border>
				<TextBlock Classes="hint"
						   Text="&quot;Device default&quot; leaves a setting as the device has it. The idle screen is what the device shows when DeckHost isn't running; choose Black to remove an old image that is stuck on the display." />
			</StackPanel>
		</ScrollViewer>

		<Border Grid.Row="2" Padding="20,12" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
			<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
				<TextBlock Text="{Binding Status}"
						   IsVisible="{Binding HasStatus}"
						   Classes.error="{Binding StatusIsError}"
						   VerticalAlignment="Center"
						   TextWrapping="Wrap" />
				<Button Grid.Column="1" Content="Close" Click="Close_OnClick" />
				<Button Grid.Column="2" Content="Save" Classes="accent" IsEnabled="{Binding CanSave}" Command="{Binding SaveCommand}" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
