<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:views="using:DeckHost.App.Views"
		x:Class="DeckHost.App.Views.PluginManagerView"
		x:DataType="vm:PluginManagerViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="LetterSpacing" Value="0.5" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource C.64748B}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Border.badge">
			<Setter Property="CornerRadius" Value="999" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</UserControl.Styles>

	<UserControl.DataTemplates>
		<DataTemplate DataType="vm:PluginEntryViewModel">
			<Border Classes="card">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
					<!-- The plugin's picture, as in the store. -->
					<Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource C.1E293B}" VerticalAlignment="Top" ClipToBounds="True">
						<Panel>
							<TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasIcon}" FontWeight="SemiBold" Foreground="{DynamicResource C.CBD5E1}" HorizontalAlignment="Center" VerticalAlignment="Center" />
							<Viewbox Width="24" Height="24" IsVisible="{Binding Icon.HasGeometry, FallbackValue=False}">
								<Canvas Width="24" Height="24"><Path Data="{Binding Icon.Geometry}" Fill="{Binding Icon.Brush}" /></Canvas>
							</Viewbox>
							<Image Source="{Binding Icon.Image}" IsVisible="{Binding Icon.HasImage, FallbackValue=False}" Stretch="Uniform" />
						</Panel>
					</Border>
					<StackPanel Grid.Column="1" Spacing="4">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
							<TextBlock Text="{Binding Version}" Foreground="{DynamicResource C.64748B}" VerticalAlignment="Center" />
								<Border Classes="badge" Background="{DynamicResource C.134E4A}" IsVisible="{Binding IsDevicePlugin}" ToolTip.Tip="A device plugin: connects hardware">
									<TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource C.99F6E4}" />
								</Border>
								<Border Classes="badge" Background="{DynamicResource C.312E81}" IsVisible="{Binding !IsDevicePlugin}" ToolTip.Tip="An action plugin: adds actions">
									<TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource C.C7D2FE}" />
								</Border>
								<Border Classes="badge" Background="{DynamicResource C.1E3A8A}" IsVisible="{Binding IsSystem}">
									<TextBlock Text="System" FontSize="11" Foreground="{DynamicResource C.BFDBFE}" />
								</Border>
								<Border Classes="badge" Background="{Binding OriginColor}" IsVisible="{Binding !IsSystem}">
									<TextBlock Text="{Binding Origin}" FontSize="11" Foreground="{DynamicResource C.E2E8F0}" />
								</Border>
							</StackPanel>
						<TextBlock Text="{Binding Details}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" />
						<TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
						<TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource C.FCA5A5}" TextWrapping="Wrap" />
						<TextBlock Text="{Binding PermissionsText}" IsVisible="{Binding HasPermissionsText}" FontSize="12" Foreground="{DynamicResource C.FDE68A}" TextWrapping="Wrap" />
						<TextBlock Text="{Binding WarningsText}" IsVisible="{Binding HasWarnings}" FontSize="12" Foreground="{DynamicResource C.FCD34D}" TextWrapping="Wrap" />
						<StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding CanChooseProcess}">
							<CheckBox Content="Run in its own process" IsChecked="{Binding RunsInOwnProcess}" IsEnabled="{Binding IsIdle}"
									  ToolTip.Tip="Recommended: a plugin that crashes or hangs then can't take DeckHost and your devices with it, and DeckHost restarts it." />
							<TextBlock Text="{Binding ProcessStatus}" IsVisible="{Binding HasProcessStatus}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" VerticalAlignment="Center" TextWrapping="Wrap" />
						</StackPanel>
						<TextBlock Text="{Binding ProcessStatus}" IsVisible="{Binding ShowsOnlyStatus}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
						<Border IsVisible="{Binding ConfirmingInProcess}" Padding="10" CornerRadius="8" Background="{DynamicResource C.2A1215}" BorderBrush="{DynamicResource C.7F1D1D}" BorderThickness="1">
							<StackPanel Spacing="8">
								<TextBlock Text="{Binding InProcessWarning}" TextWrapping="Wrap" Foreground="{DynamicResource C.FECACA}" />
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Button Content="Run it inside DeckHost" Command="{Binding ConfirmInProcessCommand}" />
									<Button Content="Keep its own process" Classes="accent" Command="{Binding CancelInProcessCommand}" />
								</StackPanel>
							</StackPanel>
						</Border>
							<TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource C.475569}" />
							<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBusy}">
								<ProgressBar IsIndeterminate="True" Width="120" VerticalAlignment="Center" />
								<TextBlock Text="{Binding BusyText}" FontSize="12" Foreground="{DynamicResource C.93C5FD}" />
							</StackPanel>
						</StackPanel>
					<StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
						<ToggleSwitch IsChecked="{Binding IsEnabled}"
									  IsVisible="{Binding CanToggle}"
									  IsEnabled="{Binding IsIdle}"
									  OnContent="Enabled"
									  OffContent="Disabled" />
						<Border Classes="badge" Background="{DynamicResource C.1E293B}" IsVisible="{Binding IsLocked}" HorizontalAlignment="Right">
							<TextBlock Text="{Binding LockedReason}" FontSize="11" Foreground="{DynamicResource C.94A3B8}" />
						</Border>
						<Button Content="Open folder"
								IsVisible="{Binding HasInstallDirectory}"
								HorizontalAlignment="Right"
								ToolTip.Tip="{Binding InstallDirectory}"
								Command="{Binding OpenFolderCommand}" />
						<Button Content="{Binding RollBackLabel}"
								IsVisible="{Binding CanRollBack}"
								IsEnabled="{Binding IsIdle}"
								HorizontalAlignment="Right"
								ToolTip.Tip="Go back to the version installed before the last update (this one is kept in turn)"
								Command="{Binding RollBackCommand}" />
						<Button Content="Uninstall"
								IsVisible="{Binding CanUninstall}"
								IsEnabled="{Binding IsIdle}"
								HorizontalAlignment="Right"
								Command="{Binding UninstallCommand}" />
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid RowDefinitions="Auto,*">
		<Border Padding="20,16"
				Background="{DynamicResource C.0F172A}"
				BorderBrush="{DynamicResource C.1E293B}"
				BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
				<StackPanel Spacing="4">
					<TextBlock Text="Plugin Manager" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
					<TextBlock Text="System plugins ship with DeckHost and can be switched off. Installed plugins can also be removed."
							   Foreground="{DynamicResource C.94A3B8}"
							   TextWrapping="Wrap" />
				</StackPanel>
				<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
					<Button Content="Plugins folder" Command="{Binding OpenPluginFolderCommand}" ToolTip.Tip="{Binding InstallDirectory}" />
					<Button Content="Logs folder" Command="{Binding OpenLogFolderCommand}" ToolTip.Tip="{Binding LogDirectory}" />
					<Button Classes="accent"
							Content="Install plugin…"
							IsEnabled="{Binding !IsBusy}"
							Click="InstallPlugin_OnClick" />
				</StackPanel>
				<Border Grid.Row="1"
						Grid.ColumnSpan="2"
						Padding="10,6"
						CornerRadius="8"
						Background="{DynamicResource C.1E293B}"
						IsVisible="{Binding HasStatus}">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
						<ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
						<TextBlock Grid.Column="1" Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource C.E2E8F0}" />
					</Grid>
				</Border>
			</Grid>
		</Border>

		<TabControl Grid.Row="1" Margin="12,8,12,0" SelectionChanged="Tabs_OnSelectionChanged">
			<TabItem Header="Installed">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="20" Spacing="12">
				<TextBlock Classes="section" Text="DEVICES" />
				<ItemsControl ItemsSource="{Binding Devices}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:DeviceInfoViewModel">
							<Border Classes="card" Margin="0,0,0,8">
								<StackPanel Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
										<Border Classes="badge" Background="{DynamicResource C.14532D}" IsVisible="{Binding IsConnected}">
											<TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource C.BBF7D0}" />
										</Border>
										<Border Classes="badge" Background="{DynamicResource C.1E293B}" IsVisible="{Binding !IsConnected}">
											<TextBlock Text="{Binding State}" FontSize="11" Foreground="{DynamicResource C.94A3B8}" />
										</Border>
									</StackPanel>
									<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
										<TextBlock Text="{Binding Detail}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" VerticalAlignment="Center" />
										<Button Grid.Column="1" Content="Settings…" IsVisible="{Binding HasSettings}" Click="DeviceSettings_OnClick"
												ToolTip.Tip="This device's settings (what it offers: brightness, lights, idle screen, pairing, firmware, …)" />
									</Grid>
									<TextBlock Foreground="{DynamicResource C.64748B}" FontSize="12" TextWrapping="Wrap"
											   Text="{Binding FirmwareText}" IsVisible="{Binding HasFirmwareText}" />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Classes="section" Text="DEVICE PLUGINS" Margin="0,8,0,0" />
				<TextBlock Classes="hint" Text="They connect hardware and the Web Deck: what DeckHost can talk to." Margin="0,-6,0,0" />
				<ItemsControl ItemsSource="{Binding DevicePlugins}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="8" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

				<TextBlock Classes="section" Text="ACTION PLUGINS: BUILT IN" Margin="0,8,0,0" />
				<TextBlock Classes="hint" Text="They add what keys, knobs and touch zones can do." Margin="0,-6,0,0" />
				<ItemsControl ItemsSource="{Binding SystemPlugins}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="8" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

				<TextBlock Classes="section" Text="ACTION PLUGINS: INSTALLED" Margin="0,8,0,0" />
				<Border Classes="card" IsVisible="{Binding HasNoInstalledPlugins}">
					<StackPanel Spacing="4">
						<TextBlock Text="No plugins installed yet." FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
						<TextBlock Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap"
								   Text="Use Install plugin… to add a plugin package (.zip). Plugins run with your user's rights, so only install packages you trust." />
					</StackPanel>
				</Border>
				<ItemsControl ItemsSource="{Binding InstalledPlugins}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="8" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
				<TextBlock Classes="section" Text="FOLDERS" Margin="0,8,0,0" />
				<Border Classes="card">
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="6">
						<TextBlock Text="DeckHost plugins" Foreground="{DynamicResource C.94A3B8}" />
						<SelectableTextBlock Grid.Column="1" Text="{Binding InstallDirectory}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
						<TextBlock Grid.Row="1" Text="Stream Deck plugins (Elgato, OpenAction)" Foreground="{DynamicResource C.94A3B8}" />
						<SelectableTextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StreamDeckDirectory}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
						<TextBlock Grid.Row="2" Text="Log files" Foreground="{DynamicResource C.94A3B8}" />
						<SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogDirectory}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
					</Grid>
				</Border>
			</StackPanel>
		</ScrollViewer>
			</TabItem>
			<TabItem Header="Store">
				<Grid RowDefinitions="Auto,Auto,*" RowSpacing="10" Margin="8,12,8,8" DataContext="{Binding Store}" x:DataType="vm:PluginStoreViewModel">
					<Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
						<TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search by name, author or description" />
						<ComboBox Grid.Column="1" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}" MinWidth="170" />
						<ComboBox Grid.Column="2" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory, Mode=TwoWay}" MinWidth="150" />
						<ComboBox Grid.Column="3" ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" MinWidth="120" />
						<Button Grid.Column="4" Content="↻" ToolTip.Tip="Reload the catalogs" Command="{Binding RefreshCommand}" />
					</Grid>
					<StackPanel Grid.Row="1" Spacing="6">
						<TextBlock Text="{Binding Summary}" Foreground="{DynamicResource C.94A3B8}" FontSize="12" TextWrapping="Wrap" />
						<Expander Header="Sources" HorizontalAlignment="Stretch">
							<StackPanel Spacing="8">
								<TextBlock Foreground="{DynamicResource C.94A3B8}" FontSize="12" TextWrapping="Wrap"
										   Text="DeckHost plugins come from the sources below, one per line: a catalog URL, a local catalog file, or a local folder (for example your plugin projects). Folders are searched for packages (.zip, .dhplugin, .streamDeckPlugin) and built plugin folders (plugin.json next to the plugin's .dll). A catalog is a JSON object keyed by plugin id, or an array, with name, author, description, version, category, download_url, repository and icon. The official DeckHost catalog is always included; add your own here." />
								<TextBox Text="{Binding CatalogUrlsText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="70" TextWrapping="NoWrap"
										 PlaceholderText="https://example.com/deckhost-catalog.json or E:\Projects\MyPlugins" />
								<Button Content="Save and reload" Command="{Binding SaveCatalogUrlsCommand}" HorizontalAlignment="Left" />
								<TextBlock Foreground="{DynamicResource C.64748B}" FontSize="11" TextWrapping="Wrap"
										   Text="Stream Deck plugins come from the OpenAction catalog and a community archive of the Elgato store (Elgato has no public store API). They run as separate programs with your user's rights, so only install what you trust. Node.js plugins need Node.js 20 or newer." />
							</StackPanel>
						</Expander>
					</StackPanel>
					<ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
						<ItemsControl ItemsSource="{Binding Items}">
							<ItemsControl.ItemsPanel>
								<ItemsPanelTemplate>
									<StackPanel Spacing="8" />
								</ItemsPanelTemplate>
							</ItemsControl.ItemsPanel>
							<ItemsControl.ItemTemplate>
								<DataTemplate x:DataType="vm:StoreItemViewModel">
									<Border Classes="card">
										<Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
											<Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource C.1E293B}" VerticalAlignment="Top" ClipToBounds="True">
												<Panel>
													<TextBlock Text="{Binding Initials}" IsVisible="{Binding !HasIcon}" FontWeight="SemiBold" Foreground="{DynamicResource C.CBD5E1}" HorizontalAlignment="Center" VerticalAlignment="Center" />
													<Image Source="{Binding Icon}" IsVisible="{Binding HasIcon}" Stretch="Uniform" />
												</Panel>
											</Border>
											<StackPanel Grid.Column="1" Spacing="3">
												<StackPanel Orientation="Horizontal" Spacing="8">
													<TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
													<Border Classes="badge" Background="{Binding SourceColor}">
														<TextBlock Text="{Binding Source}" FontSize="11" Foreground="{DynamicResource C.E2E8F0}" />
													</Border>
												</StackPanel>
												<TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource C.64748B}" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" MaxLines="{Binding DescriptionLines}" />
												<TextBlock Text="{Binding PermissionsText}" IsVisible="{Binding HasPermissions}" FontSize="11" Foreground="{DynamicResource C.FDE68A}" />
												<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasProgress}">
													<ProgressBar IsIndeterminate="{Binding IsInstalling}" Width="120" VerticalAlignment="Center" />
													<TextBlock Text="{Binding Progress}" FontSize="12" Foreground="{DynamicResource C.93C5FD}" />
												</StackPanel>
											</StackPanel>
											<StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
<Button Content="Install" Classes="accent" IsVisible="{Binding ShowInstall}" IsEnabled="{Binding CanInstall}" Command="{Binding InstallCommand}" HorizontalAlignment="Right" />
												<Button Content="Buy" Classes="accent" IsVisible="{Binding CanBuy}" Command="{Binding BuyCommand}" HorizontalAlignment="Right" ToolTip.Tip="A paid plugin: buy it on its page, then install the file you get with Install plugin…" />
												<Border Classes="badge" Background="{DynamicResource C.14532D}" IsVisible="{Binding IsInstalled}" HorizontalAlignment="Right">
													<TextBlock Text="Installed" FontSize="11" Foreground="{DynamicResource C.BBF7D0}" />
												</Border>
												<Button Content="Page" IsVisible="{Binding HasPage}" ToolTip.Tip="{Binding PageToolTip}" Command="{Binding OpenPageCommand}" HorizontalAlignment="Right" />
												<Button Content="{Binding ExpandText}" ToolTip.Tip="Show the plugin's README" Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Right" />
											</StackPanel>
											<StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="8" Margin="0,12,0,0" IsVisible="{Binding IsExpanded}">
												<Border Height="1" Background="{DynamicResource C.1E293B}" />
												<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasReadmeStatus}">
													<ProgressBar IsIndeterminate="True" Width="80" IsVisible="{Binding IsLoadingReadme}" VerticalAlignment="Center" />
													<TextBlock Text="{Binding ReadmeStatus}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
												</StackPanel>
												<views:MarkdownView IsVisible="{Binding HasReadme}"
																	Markdown="{Binding ReadmeMarkdown}"
																	ImageBase="{Binding ReadmeImageBase}"
																	LinkBase="{Binding ReadmeLinkBase}"
																	ImageLoader="{Binding ImageLoader}" />
											</StackPanel>
										</Grid>
									</Border>
								</DataTemplate>
							</ItemsControl.ItemTemplate>
						</ItemsControl>
					</ScrollViewer>
				</Grid>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
