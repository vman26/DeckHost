<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="DeckHost.App.Views.MainWindow"
		x:DataType="vm:MainViewModel"
		Width="1520"
		Height="920"
		MinWidth="1240"
		MinHeight="760"
		Background="#111827"
		Icon="/Assets/avalonia-logo.ico"
		Title="DeckHost Studio">

	<Grid ColumnDefinitions="340,*,360" RowDefinitions="Auto,*">
		<Border Grid.ColumnSpan="3"
				Padding="20,16"
				Background="#0F172A"
				BorderBrush="#1E293B"
				BorderThickness="0,0,0,1">
			<DockPanel LastChildFill="True">
				<Button DockPanel.Dock="Left"
						Width="44"
						Height="44"
						Margin="0,0,16,0"
						FontSize="20"
						Content="☰">
					<Button.Flyout>
						<Flyout Placement="Bottom">
							<StackPanel Width="260"
										Spacing="12"
										Margin="8">
								<StackPanel Spacing="4">
									<TextBlock Text="Navigation"
											   FontWeight="SemiBold"
											   Foreground="#0F172A" />
									<TextBlock Text="Current page"
											   FontSize="12"
											   Foreground="#64748B" />
									<TextBlock Text="{Binding CurrentPageName}"
											   FontWeight="SemiBold" />
								</StackPanel>
								<Separator />
								<Button Content="Open Plugin Manager"
										HorizontalAlignment="Stretch"
										Click="OpenPluginManager_OnClick" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>

				<StackPanel Spacing="4">
					<TextBlock Text="DeckHost Studio"
							   FontSize="24"
							   FontWeight="SemiBold"
							   Foreground="#F8FAFC" />
					<TextBlock Text="Profiles, plugins, and a device-first preview surface."
							   Foreground="#94A3B8" />
				</StackPanel>

				<Border DockPanel.Dock="Right"
						Padding="12,8"
						Background="#111827"
						BorderBrush="#1E293B"
						BorderThickness="1"
						CornerRadius="12">
					<StackPanel Spacing="2">
						<TextBlock Text="{Binding SelectedProfileName}"
								   FontWeight="SemiBold"
								   Foreground="#E2E8F0" />
						<TextBlock Text="{Binding SelectedProfileSummary}"
								   FontSize="12"
								   Foreground="#64748B" />
						<TextBlock Text="{Binding ConnectionStatus}"
								   FontSize="12"
								   Foreground="#93C5FD" />
					</StackPanel>
				</Border>
			</DockPanel>
		</Border>

		<Border Grid.Row="1"
				Grid.Column="0"
				Margin="18"
				Padding="16"
				Background="#0F172A"
				BorderBrush="#1E293B"
				BorderThickness="1"
				CornerRadius="16">
			<Grid RowDefinitions="Auto,Auto,Auto,*"
				  RowSpacing="14">
				<TextBlock Text="Profiles &amp; Actions"
						   FontSize="18"
						   FontWeight="SemiBold"
						   Foreground="#F8FAFC" />

				<StackPanel Grid.Row="1"
							Spacing="8">
					<TextBlock Text="Active Profile"
							   FontSize="12"
							   Foreground="#94A3B8" />
					<ComboBox ItemsSource="{Binding Profiles}"
							  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
						<ComboBox.ItemTemplate>
							<DataTemplate x:DataType="vm:ProfileItemViewModel">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding Name}" />
									<TextBlock Text="{Binding Summary}"
											   FontSize="11"
											   Foreground="#64748B" />
								</StackPanel>
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>
				</StackPanel>

				<TextBox Grid.Row="2"
						 PlaceholderText="Search plugin actions..."
						 Text="{Binding SearchText, Mode=TwoWay}" />

				<ScrollViewer Grid.Row="3"
							  HorizontalScrollBarVisibility="Disabled">
					<ItemsControl ItemsSource="{Binding ActionGroups}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:PluginActionGroupViewModel">
								<Expander Margin="0,0,0,10"
										  IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
										  Background="#111827"
										  BorderBrush="#334155"
										  BorderThickness="1">
									<Expander.Header>
										<StackPanel Margin="10,8"
													Spacing="2">
											<TextBlock Text="{Binding PluginName}"
													   FontWeight="SemiBold"
													   Foreground="#F8FAFC" />
											<TextBlock Text="Actions from this plugin"
													   FontSize="11"
													   Foreground="#64748B" />
										</StackPanel>
									</Expander.Header>
									<ItemsControl ItemsSource="{Binding Actions}">
										<ItemsControl.ItemTemplate>
											<DataTemplate x:DataType="vm:ActionItemViewModel">
												<Border Margin="10,0,10,10"
														Padding="12"
														Background="#0B1120"
														BorderBrush="#334155"
														BorderThickness="1"
														CornerRadius="12"
														Cursor="Hand"
														PointerPressed="ActionCard_OnPointerPressed">
													<StackPanel Spacing="6">
														<TextBlock Text="{Binding Name}"
																   FontWeight="SemiBold"
																   Foreground="#F8FAFC" />
														<TextBlock Text="{Binding Summary}"
																   FontSize="12"
																   Foreground="#94A3B8"
																   TextWrapping="Wrap" />
													</StackPanel>
												</Border>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</Expander>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</Grid>
		</Border>

		<Grid Grid.Row="1"
			  Grid.Column="1"
			  Margin="0,18,0,18"
			  RowDefinitions="Auto,*"
			  RowSpacing="14">
			<Border Padding="14,12"
					Background="#0F172A"
					BorderBrush="#1E293B"
					BorderThickness="1"
					CornerRadius="14">
				<DockPanel>
					<StackPanel>
						<TextBlock Text="Visual Device Canvas"
								   FontSize="18"
								   FontWeight="SemiBold"
								   Foreground="#F8FAFC" />
						<TextBlock Text="{Binding DeviceName}"
								   FontSize="12"
								   Foreground="#64748B" />
					</StackPanel>
					<TextBlock DockPanel.Dock="Right"
							   Text="{Binding StatusMessage}"
							   VerticalAlignment="Center"
							   Foreground="#94A3B8"
							   TextTrimming="CharacterEllipsis" />
				</DockPanel>
			</Border>

			<Border Grid.Row="1"
					Padding="18"
					Background="#0B1120"
					BorderBrush="#1E293B"
					BorderThickness="1"
					CornerRadius="18">
				<ScrollViewer HorizontalScrollBarVisibility="Auto"
							  VerticalScrollBarVisibility="Auto">
					<Viewbox Stretch="Uniform"
							 HorizontalAlignment="Center"
							 VerticalAlignment="Center">
						<Border Padding="18"
								Background="#020617"
								BorderBrush="#334155"
								BorderThickness="1"
								CornerRadius="24">
							<ItemsControl ItemsSource="{Binding ControlItems}"
										  Width="{Binding CanvasWidth}"
										  Height="{Binding CanvasHeight}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<Canvas Background="#111827" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ControlItemViewModel">
										<Border Width="{Binding Width}"
												Height="{Binding Height}"
												Padding="8,4"
												Background="{Binding SurfaceBrush}"
												BorderBrush="#E2E8F0"
												BorderThickness="1"
												CornerRadius="{Binding CornerRadius}"
												Cursor="Hand"
												PointerPressed="ControlCard_OnPointerPressed">
											<Border.ContextMenu>
												<ContextMenu DataContext="{Binding}">
													<MenuItem Header="Customize"
															  IsEnabled="{Binding SupportsCustomization}"
															  Click="ControlCustomize_OnClick" />
													<MenuItem Header="Remove Assignment"
															  IsEnabled="{Binding HasAssignment}"
															  Click="ControlRemove_OnClick" />
												</ContextMenu>
											</Border.ContextMenu>
											<Border.RenderTransform>
												<TranslateTransform X="{Binding X}" Y="{Binding Y}" />
											</Border.RenderTransform>
											<Grid RowDefinitions="Auto,*,Auto"
												  RowSpacing="6">
												<DockPanel>
													<TextBlock Text="{Binding DisplayName}"
															   FontSize="11"
															   FontWeight="SemiBold"
															   Foreground="#F8FAFC" />
													<TextBlock DockPanel.Dock="Right"
															   IsVisible="{Binding ShowRemoveHint}"
															   Text="Drag off to remove"
															   FontSize="10"
															   Foreground="#BFDBFE" />
												</DockPanel>

												<StackPanel Grid.Row="1"
															IsVisible="{Binding ShowDetails}"
															Spacing="4"
															HorizontalAlignment="Center"
															VerticalAlignment="Center">
													<Border IsVisible="{Binding HasPreviewImage}"
															Padding="8,4"
															Background="#1E293B"
															CornerRadius="8">
														<TextBlock Text="{Binding PreviewImageLabel}"
																   FontSize="10"
																   Foreground="#BFDBFE"
																   TextWrapping="Wrap"
																   TextAlignment="Center" />
													</Border>
													<TextBlock Text="{Binding PreviewText}"
															   FontSize="12"
															   FontWeight="SemiBold"
															   Foreground="#F8FAFC"
															   TextWrapping="Wrap"
															   TextAlignment="Center"
															   MaxWidth="150" />
												</StackPanel>

												<TextBlock Grid.Row="2"
														   IsVisible="{Binding ShowDetails}"
														   Text="{Binding TypeLabel}"
														   HorizontalAlignment="Center"
														   FontSize="10"
														   Foreground="#CBD5E1" />
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</Viewbox>
				</ScrollViewer>
			</Border>
		</Grid>

		<Border Grid.Row="1"
				Grid.Column="2"
				Margin="18"
				Padding="16"
				Background="#0F172A"
				BorderBrush="#1E293B"
				BorderThickness="1"
				CornerRadius="16">
			<ScrollViewer HorizontalScrollBarVisibility="Disabled">
				<Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*"
					  RowSpacing="14">
					<TextBlock Text="Property Inspector"
							   FontSize="18"
							   FontWeight="SemiBold"
							   Foreground="#F8FAFC" />

					<Border Grid.Row="1"
							Padding="12"
							Background="#111827"
							BorderBrush="#334155"
							BorderThickness="1"
							CornerRadius="12">
						<StackPanel Spacing="4">
							<TextBlock Text="Selected Control"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<TextBlock Text="{Binding SelectedControlName}"
									   FontWeight="SemiBold"
									   Foreground="#F8FAFC" />
							<TextBlock Text="{Binding SelectedControlType}"
									   Foreground="#CBD5E1" />
						</StackPanel>
					</Border>

					<Border Grid.Row="2"
							Padding="12"
							Background="#111827"
							BorderBrush="#334155"
							BorderThickness="1"
							CornerRadius="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Input Capabilities"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<TextBlock Text="{Binding SelectedControlInputs}"
									   Foreground="#E2E8F0"
									   TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Grid.Row="3"
							Padding="12"
							Background="#111827"
							BorderBrush="#334155"
							BorderThickness="1"
							CornerRadius="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Output Capabilities"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<TextBlock Text="{Binding SelectedControlOutputs}"
									   Foreground="#E2E8F0"
									   TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Grid.Row="4"
							Padding="12"
							Background="#111827"
							BorderBrush="#334155"
							BorderThickness="1"
							CornerRadius="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Assigned Action"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<TextBlock Text="{Binding SelectedAssignmentName}"
									   FontWeight="SemiBold"
									   Foreground="#F8FAFC" />
							<TextBlock Text="{Binding SelectedAssignmentCapabilities}"
									   Foreground="#CBD5E1"
									   TextWrapping="Wrap" />
							<Button Content="Customize Selected Control"
									HorizontalAlignment="Left"
									Click="CustomizeSelectedControl_OnClick" />
						</StackPanel>
					</Border>

					<Border Grid.Row="5"
							Padding="12"
							Background="#111827"
							BorderBrush="#334155"
							BorderThickness="1"
							CornerRadius="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Runtime Connection"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<TextBlock Text="{Binding ConnectionStatus}"
									   FontWeight="SemiBold"
									   Foreground="#F8FAFC" />
							<TextBlock Text="{Binding ConnectionDetail}"
									   Foreground="#CBD5E1"
									   TextWrapping="Wrap" />
						</StackPanel>
					</Border>

					<Border Grid.Row="6"
							Padding="12"
							Background="#111827"
							BorderBrush="#334155"
							BorderThickness="1"
							CornerRadius="12">
						<StackPanel Spacing="10">
							<TextBlock Text="Multi Action Steps"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<TextBlock IsVisible="{Binding SelectedAssignmentIsMultiAction}"
									   Text="Drop additional plugin actions onto a control already using Multi Action to append steps."
									   Foreground="#E2E8F0"
									   TextWrapping="Wrap" />
							<ItemsControl IsVisible="{Binding SelectedAssignmentIsMultiAction}"
										  ItemsSource="{Binding SelectedMultiActionSteps}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:ActionItemViewModel">
										<Border Margin="0,0,0,8"
												Padding="10"
												Background="#0B1120"
												BorderBrush="#334155"
												BorderThickness="1"
												CornerRadius="10">
											<StackPanel Spacing="4">
												<TextBlock Text="{Binding Name}"
														   FontWeight="SemiBold"
														   Foreground="#F8FAFC" />
												<TextBlock Text="{Binding PluginName}"
														   FontSize="11"
														   Foreground="#94A3B8" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock IsVisible="{Binding ShowMultiActionHint}"
									   Text="Assign Multi Action to a control first to start programming a step sequence."
									   Foreground="#64748B"
									   TextWrapping="Wrap" />
							<TextBlock Margin="0,10,0,0"
									   Text="Runtime Log"
									   FontSize="12"
									   Foreground="#94A3B8" />
							<ItemsControl ItemsSource="{Binding RuntimeLogs}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<TextBlock FontSize="11"
												   Foreground="#CBD5E1"
												   TextWrapping="Wrap"
												   Text="{Binding Message}" />
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
				</Grid>
			</ScrollViewer>
		</Border>
	</Grid>
</Window>
