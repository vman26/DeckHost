<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:local="using:DeckHost.App.Views"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		x:Class="DeckHost.App.Views.MainWindow"
		x:DataType="vm:MainViewModel"
		Width="1440"
		Height="920"
		MinWidth="1020"
		MinHeight="680"
		Background="{DynamicResource C.111318}"
		Icon="/Assets/deckhost.ico"
		Title="DeckHost Studio">

	<Window.Styles>
		<!-- Header buttons: an icon on a plain background, a soft highlight on hover. -->
		<Style Selector="Button.tool, ToggleButton.tool">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="8" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Foreground" Value="{DynamicResource C.CBD5E1}" />
		</Style>
		<Style Selector="Button.tool:pointerover /template/ ContentPresenter, ToggleButton.tool:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource C.262B36}" />
		</Style>
		<Style Selector="Button.tool:disabled /template/ ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Button.tool:disabled">
			<Setter Property="Opacity" Value="0.35" />
		</Style>
		<Style Selector="ToggleButton.tool:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource C.1D4ED8}" />
		</Style>
		<Style Selector="Path.toolIcon">
			<Setter Property="Fill" Value="{DynamicResource C.CBD5E1}" />
		</Style>
		<!-- The action list, like the Stream Deck app: plugin rows that fold open, actions with their icon. -->
		<Style Selector="Border.actionItem">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="Border.actionItem:pointerover">
			<Setter Property="Background" Value="{DynamicResource C.262B36}" />
		</Style>
		<Style Selector="ToggleButton.groupHeader">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Stretch" />
			<Setter Property="Padding" Value="10,10" />
			<Setter Property="CornerRadius" Value="8" />
		</Style>
		<Style Selector="ToggleButton.groupHeader:pointerover /template/ ContentPresenter, ToggleButton.groupHeader:checked /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource C.1E222B}" />
		</Style>
		<!-- Page buttons under the device: small pills, the current one filled. -->
		<Style Selector="Button.page">
			<Setter Property="MinWidth" Value="30" />
			<Setter Property="Height" Value="24" />
			<Setter Property="Padding" Value="8,0" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="{DynamicResource C.262B36}" />
			<Setter Property="Foreground" Value="{DynamicResource C.CBD5E1}" />
		</Style>
		<Style Selector="Button.page.current">
			<Setter Property="Background" Value="{DynamicResource C.E2E8F0}" />
			<Setter Property="Foreground" Value="{DynamicResource C.111318}" />
		</Style>
		<Style Selector="Button.page.current:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource C.F8FAFC}" />
			<Setter Property="Foreground" Value="{DynamicResource C.111318}" />
		</Style>
		<Style Selector="TextBlock.panelTitle">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.64748B}" />
			<Setter Property="LetterSpacing" Value="0.6" />
		</Style>
		<Style Selector="Border.debugCard">
			<Setter Property="Padding" Value="12" />
			<Setter Property="Background" Value="{DynamicResource C.161A22}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.262B36}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="10" />
		</Style>
	</Window.Styles>

	<Window.DataTemplates>
		<!-- The selected control's editor, below the device. -->
		<DataTemplate DataType="vm:ControlCustomizationViewModel">
			<local:ControlCustomizationView />
		</DataTemplate>
	</Window.DataTemplates>

	<Panel>
		<Grid RowDefinitions="Auto,*">
			<!-- Header: menu, device and profile, update notice, tools. -->
			<Border Padding="16,10" Background="{DynamicResource C.16181E}" BorderBrush="{DynamicResource C.262B36}" BorderThickness="0,0,0,1">
				<Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="14">
					<Button Classes="tool" Width="40" Height="40" FontSize="18" Content="☰" ToolTip.Tip="Menu">
						<Button.Flyout>
							<Flyout Placement="BottomEdgeAlignedLeft">
								<StackPanel Width="250" Spacing="8" Margin="6">
									<Button Content="Profiles" HorizontalAlignment="Stretch" Click="OpenProfileManager_OnClick" />
									<Button Content="Plugins and store" HorizontalAlignment="Stretch" Click="OpenPluginManager_OnClick" />
									<Button Content="Device settings" HorizontalAlignment="Stretch" Click="OpenDeviceSettings_OnClick" />
									<Button Content="DeckHost settings" HorizontalAlignment="Stretch" Click="OpenAppSettings_OnClick" />
									<Button Content="Help and support" HorizontalAlignment="Stretch" Click="OpenSupport_OnClick" />
									<Button Content="Welcome tour" HorizontalAlignment="Stretch" Click="OpenWelcome_OnClick" />
									<Separator />
									<CheckBox Content="Switch profiles with the active app"
											  IsChecked="{Binding AutoSwitchEnabled}"
											  IsEnabled="{Binding AutoSwitchSupported}" />
								</StackPanel>
							</Flyout>
						</Button.Flyout>
					</Button>

					<StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<Image Source="/Assets/deckhost-64.png" Width="22" Height="22" VerticalAlignment="Center" ToolTip.Tip="DeckHost" />
							<TextBlock Text="{Binding DeviceName}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" VerticalAlignment="Center" IsVisible="{Binding !HasSeveralDevices}" />
							<!-- Several devices (N4 Pro, Stream Decks, the web deck): pick the one to edit. -->
							<ComboBox ItemsSource="{Binding DeviceChoices}"
									  SelectedItem="{Binding PickedDevice, Mode=TwoWay}"
									  IsVisible="{Binding HasSeveralDevices}"
									  MinWidth="180"
									  FontSize="16"
									  FontWeight="SemiBold"
									  Background="Transparent"
									  BorderThickness="0"
									  Padding="0,2"
									  ToolTip.Tip="The device you're editing">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding Label}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Border Padding="7,2" CornerRadius="999" Background="{DynamicResource C.1E293B}" VerticalAlignment="Center">
								<TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="{DynamicResource C.93C5FD}" />
							</Border>
						</StackPanel>
						<!-- The profile picker, like the Stream Deck app's profile name under the device. -->
						<StackPanel Orientation="Horizontal" Spacing="4">
							<ComboBox ItemsSource="{Binding Profiles}"
									  SelectedItem="{Binding SelectedRootProfile, Mode=TwoWay}"
									  MinWidth="160"
									  Background="Transparent"
									  BorderThickness="0"
									  Padding="0,2"
									  ToolTip.Tip="The profile you're editing (and the device shows)">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:ProfileItemViewModel">
										<TextBlock Text="{Binding Name}" Foreground="{DynamicResource C.CBD5E1}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Classes="tool" Padding="6,2" FontSize="12" Content="Manage…" Foreground="{DynamicResource C.64748B}" Click="OpenProfileManager_OnClick" />
						</StackPanel>
					</StackPanel>

					<!-- An available update (DataContext: the update service, set in code). -->
					<Border Grid.Column="2"
							x:Name="UpdateBanner"
							HorizontalAlignment="Right"
							VerticalAlignment="Center"
							IsVisible="False"
							Padding="12,6"
							Background="{DynamicResource C.172554}"
							BorderBrush="{DynamicResource C.1D4ED8}"
							BorderThickness="1"
							CornerRadius="12"
							x:DataType="vm:UpdateViewModel">
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
							<TextBlock Text="⬆" FontSize="16" Foreground="{DynamicResource C.93C5FD}" VerticalAlignment="Center" />
							<StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
								<TextBlock Text="{Binding AvailableTitle}" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
								<TextBlock Text="{Binding AvailableSummary}" FontSize="11" Foreground="{DynamicResource C.93C5FD}" />
							</StackPanel>
							<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
								<Button Content="What's new" Classes="accent" Command="{Binding ShowDetailsCommand}" />
								<Button Content="✕" ToolTip.Tip="Remind me next time DeckHost starts" Command="{Binding LaterCommand}" />
							</StackPanel>
						</Grid>
					</Border>

					<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
						<Button Classes="tool" ToolTip.Tip="{Binding UndoTip}" IsEnabled="{Binding CanUndo}" Command="{Binding UndoCommand}">
							<Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M9 4 3 10l6 6v-4.5h5a4.5 4.5 0 0 1 0 9h-3V23h3a7 7 0 0 0 0-14H9Z" /></Canvas></Viewbox>
						</Button>
						<Button Classes="tool" ToolTip.Tip="{Binding RedoTip}" IsEnabled="{Binding CanRedo}" Command="{Binding RedoCommand}">
							<Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M15 4l6 6-6 6v-4.5h-5a4.5 4.5 0 0 0 0 9h3V23h-3a7 7 0 0 1 0-14h5Z" /></Canvas></Viewbox>
						</Button>
						<Button Classes="tool" ToolTip.Tip="Profiles" Click="OpenProfileManager_OnClick">
							<Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M4 4h7v7H4Z M13 4h7v7h-7Z M4 13h7v7H4Z M13 13h7v7h-7Z" /></Canvas></Viewbox>
						</Button>
						<Button Classes="tool" ToolTip.Tip="Plugins and store" Click="OpenPluginManager_OnClick">
							<Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M10 3a2 2 0 0 1 4 0v2h4v4h2a2 2 0 0 1 0 4h-2v6h-5v-2a2 2 0 0 0-4 0v2H4v-6h2a2 2 0 0 0 0-4H4V5h6Z" /></Canvas></Viewbox>
						</Button>
						<Button Classes="tool" ToolTip.Tip="Device settings" Click="OpenDeviceSettings_OnClick">
							<Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M3 5h18v14H3Z M5 7v10h14V7Z M7 9h4v3H7Z M13 9h4v3h-4Z M8 14h8v1.5H8Z" /></Canvas></Viewbox>
						</Button>
						<Button Classes="tool" ToolTip.Tip="DeckHost settings" Click="OpenAppSettings_OnClick">
							<Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M10.3 2h3.4l.5 2.6 1.7.9 2.4-1.2 2.4 2.4-1.2 2.4.9 1.7 2.6.5v3.4l-2.6.5-.9 1.7 1.2 2.4-2.4 2.4-2.4-1.2-1.7.9-.5 2.6h-3.4l-.5-2.6-1.7-.9-2.4 1.2-2.4-2.4 1.2-2.4-.9-1.7L2 13.7v-3.4l2.6-.5.9-1.7-1.2-2.4 2.4-2.4 2.4 1.2 1.7-.9Z M12 8.5a3.5 3.5 0 1 0 0 7a3.5 3.5 0 1 0 0-7Z" /></Canvas></Viewbox>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<!-- The workspace: the device and the selected control's editor, the debug panel, the actions. -->
			<Grid Grid.Row="1" x:Name="Workspace" ColumnDefinitions="*,Auto,320">
				<Grid RowDefinitions="400,5,*" MinWidth="560">
					<!-- The device, at a fixed size: opening plugins or the editor doesn't resize it. -->
					<Grid Background="{DynamicResource C.111318}">
						<Viewbox Stretch="Uniform" StretchDirection="Both" Margin="24,16,24,64" HorizontalAlignment="Center" VerticalAlignment="Center">
							<Border Padding="18" Background="{DynamicResource C.0B0D12}" BorderBrush="{DynamicResource C.262B36}" BorderThickness="1" CornerRadius="24">
								<!-- The background is the color the device shows between its controls for this profile. -->
								<ItemsControl ItemsSource="{Binding ControlItems}"
											  Width="{Binding CanvasWidth}"
											  Height="{Binding CanvasHeight}"
											  Background="{Binding CanvasBackground}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<Canvas Background="Transparent" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:ControlItemViewModel">
											<!-- Shows the exact image the device shows (rendered by the host), with live press feedback. -->
											<Border Width="{Binding Width}"
													Height="{Binding Height}"
													Background="{Binding SurfaceBrush}"
													BorderBrush="{Binding OutlineBrush}"
													BorderThickness="{Binding OutlineThickness}"
													CornerRadius="{Binding CornerRadius}"
													ClipToBounds="True"
													Cursor="Hand"
													Focusable="True"
													PointerPressed="ControlCard_OnPointerPressed"
													PointerMoved="ControlCard_OnPointerMoved"
													PointerReleased="ControlCard_OnPointerReleased"
													PointerWheelChanged="ControlCard_OnPointerWheelChanged"
													ToolTip.Tip="{Binding ToolTipText}">
												<Border.ContextMenu>
													<ContextMenu DataContext="{Binding}">
														<MenuItem Header="Customize"
																  IsEnabled="{Binding SupportsCustomization}"
																  Click="ControlCustomize_OnClick" />
														<MenuItem Header="Remove Assignment"
																  IsEnabled="{Binding HasAssignment}"
																  Click="ControlRemove_OnClick" />
													</ContextMenu>
												</Border.ContextMenu>
												<Border.RenderTransform>
													<TranslateTransform X="{Binding X}" Y="{Binding Y}" />
												</Border.RenderTransform>
												<Grid>
													<!-- A knob: a flat circle like the keys, inside its LED ring in the light's live color. -->
													<Ellipse IsVisible="{Binding SupportsLight}" Stroke="{Binding LightBrush}" StrokeThickness="3" Margin="3" IsHitTestVisible="False" />
													<Image Source="{Binding PreviewBitmap}"
														   IsVisible="{Binding HasPreview}"
														   Stretch="Fill" />

													<Grid RowDefinitions="Auto,*,Auto"
														  RowSpacing="4"
														  Margin="8,4"
														  IsVisible="{Binding !HasPreview}">
														<TextBlock Text="{Binding DisplayName}"
																   IsVisible="{Binding ShowName}"
																   FontSize="11"
																   FontWeight="SemiBold"
																   HorizontalAlignment="Center"
																   Foreground="{DynamicResource C.64748B}" />
														<TextBlock Grid.Row="1"
																   IsVisible="{Binding ShowTextPreview}"
																   Text="{Binding PreviewText}"
																   FontSize="11"
																   Foreground="{DynamicResource C.E2E8F0}"
																   TextWrapping="Wrap"
																   TextAlignment="Center"
																   HorizontalAlignment="Center"
																   VerticalAlignment="Center" />
														<TextBlock Grid.Row="2"
																   IsVisible="{Binding ShowDetails}"
																   Text="{Binding TypeLabel}"
																   HorizontalAlignment="Center"
																   FontSize="10"
																   Foreground="{DynamicResource C.475569}" />
													</Grid>

													<!-- Press feedback from the device or a double-click. -->
													<Border Background="{DynamicResource C.66FFFFFF}"
															IsVisible="{Binding IsPressed}"
															IsHitTestVisible="False" />
													<TextBlock Text="{Binding InputIndicator}"
															   IsVisible="{Binding HasInputIndicator}"
															   IsHitTestVisible="False"
															   FontSize="28"
															   FontWeight="Bold"
															   Foreground="{DynamicResource C.0F172A}"
															   HorizontalAlignment="Center"
															   VerticalAlignment="Center" />
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</Border>
						</Viewbox>
						<!-- Pages of the profile (and where an open folder is), like the Stream Deck app's page dots. -->
						<StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="20,0,20,6" Spacing="4">
							<StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsInFolder}">
								<Button Classes="tool" Padding="8,3" Click="CloseFolder_OnClick" ToolTip.Tip="Leave the folder">
									<StackPanel Orientation="Horizontal" Spacing="4">
										<Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M15.5 4L17 5.5L10.5 12L17 18.5L15.5 20L7.5 12Z" /></Canvas></Viewbox>
										<TextBlock Text="Back" FontSize="12" Foreground="{DynamicResource C.CBD5E1}" VerticalAlignment="Center" />
									</StackPanel>
								</Button>
								<TextBlock Text="{Binding FolderTrail}" FontSize="12" Foreground="{DynamicResource C.FBBF24}" VerticalAlignment="Center" />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
								<ItemsControl ItemsSource="{Binding PageTabs}" IsVisible="{Binding HasPages}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Orientation="Horizontal" Spacing="6" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:PageTabViewModel">
											<Button Classes="page" Classes.current="{Binding IsCurrent}" Content="{Binding Number}" Command="{Binding SelectCommand}"
													ToolTip.Tip="Page (right-click to remove)">
												<Button.ContextMenu>
													<ContextMenu>
														<MenuItem Header="Remove page" IsEnabled="{Binding CanDelete}" Command="{Binding DeleteCommand}" />
													</ContextMenu>
												</Button.ContextMenu>
											</Button>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<Button Classes="page" Content="+" ToolTip.Tip="Add a page to this profile" Click="AddPage_OnClick" />
							</StackPanel>
							<TextBlock Text="{Binding StatusMessage}"
									   HorizontalAlignment="Center"
									   FontSize="12"
									   Foreground="{DynamicResource C.64748B}"
									   TextTrimming="CharacterEllipsis" />
						</StackPanel>
					</Grid>

					<GridSplitter Grid.Row="1" Background="{DynamicResource C.262B36}" ResizeDirection="Rows" ToolTip.Tip="Drag to give the device or the editor more room" />

					<!-- The selected control's editor (what Customize was). -->
					<Border Grid.Row="2" Background="{DynamicResource C.16181E}">
						<Panel>
							<ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasEditor}">
								<ContentControl Content="{Binding Editor}" />
							</ScrollViewer>
							<TextBlock IsVisible="{Binding !HasEditor}"
									   Text="Select a control to configure its action."
									   Foreground="{DynamicResource C.64748B}"
									   FontSize="15"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center" />
						</Panel>
					</Border>
				</Grid>

				<!-- Debug panel (DeckHost settings → Show the debug panel). -->
				<Border Grid.Column="1" Width="300" IsVisible="{Binding ShowDebugPanel}" Background="{DynamicResource C.13161C}" BorderBrush="{DynamicResource C.262B36}" BorderThickness="1,0,0,0">
					<ScrollViewer HorizontalScrollBarVisibility="Disabled">
						<StackPanel Margin="14" Spacing="10">
							<TextBlock Classes="panelTitle" Text="DEBUG" />
							<Border Classes="debugCard">
								<StackPanel Spacing="3">
									<TextBlock Text="Selected control" FontSize="11" Foreground="{DynamicResource C.64748B}" />
									<TextBlock Text="{Binding SelectedControlName}" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
									<TextBlock Text="{Binding SelectedControlType}" Foreground="{DynamicResource C.CBD5E1}" />
								</StackPanel>
							</Border>
							<Border Classes="debugCard">
								<StackPanel Spacing="3">
									<TextBlock Text="Inputs" FontSize="11" Foreground="{DynamicResource C.64748B}" />
									<TextBlock Text="{Binding SelectedControlInputs}" Foreground="{DynamicResource C.E2E8F0}" TextWrapping="Wrap" />
									<TextBlock Text="Outputs" FontSize="11" Foreground="{DynamicResource C.64748B}" Margin="0,6,0,0" />
									<TextBlock Text="{Binding SelectedControlOutputs}" Foreground="{DynamicResource C.E2E8F0}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
							<Border Classes="debugCard">
								<StackPanel Spacing="3">
									<TextBlock Text="Assigned action" FontSize="11" Foreground="{DynamicResource C.64748B}" />
									<TextBlock Text="{Binding SelectedAssignmentName}" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
									<TextBlock Text="{Binding SelectedAssignmentCapabilities}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
							<Border Classes="debugCard">
								<StackPanel Spacing="3">
									<TextBlock Text="Runtime connection" FontSize="11" Foreground="{DynamicResource C.64748B}" />
									<TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
									<TextBlock Text="{Binding ConnectionDetail}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
								</StackPanel>
							</Border>
							<Border Classes="debugCard">
								<StackPanel Spacing="4">
									<TextBlock Text="Runtime log" FontSize="11" Foreground="{DynamicResource C.64748B}" />
									<ItemsControl ItemsSource="{Binding RuntimeLogs}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<TextBlock FontSize="11" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" Text="{Binding Message}" />
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</StackPanel>
					</ScrollViewer>
				</Border>

				<!-- Actions, grouped by plugin. Drag one onto a control (or into a Multi Action's steps). -->
				<Border Grid.Column="2" Background="{DynamicResource C.16181E}" BorderBrush="{DynamicResource C.262B36}" BorderThickness="1,0,0,0">
					<Grid RowDefinitions="Auto,*">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="12,12,12,8">
							<TextBox PlaceholderText="Search actions" Text="{Binding SearchText, Mode=TwoWay}" />
							<Button Grid.Column="1" Classes="tool" ToolTip.Tip="Get more plugins" Click="OpenPluginManager_OnClick">
								<Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7Z" /></Canvas></Viewbox>
							</Button>
						</Grid>
						<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
							<ItemsControl ItemsSource="{Binding ActionGroups}" Margin="6,0,6,12">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:PluginActionGroupViewModel">
										<StackPanel>
											<ToggleButton Classes="groupHeader" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
												<Grid ColumnDefinitions="14,26,*,Auto" ColumnSpacing="8">
													<TextBlock Text="›" FontSize="16" Foreground="{DynamicResource C.94A3B8}" VerticalAlignment="Center" IsVisible="{Binding !IsExpanded}" />
													<TextBlock Text="⌄" FontSize="14" Foreground="{DynamicResource C.94A3B8}" VerticalAlignment="Top" IsVisible="{Binding IsExpanded}" />
													<Panel Grid.Column="1" Width="26" Height="26">
														<Viewbox IsVisible="{Binding Icon.HasGeometry}">
															<Canvas Width="24" Height="24"><Path Data="{Binding Icon.Geometry}" Fill="{Binding Icon.Brush}" /></Canvas>
														</Viewbox>
														<Image Source="{Binding Icon.Image}" IsVisible="{Binding Icon.HasImage}" Stretch="Uniform" />
													</Panel>
													<TextBlock Grid.Column="2" Text="{Binding PluginName}" FontWeight="SemiBold" Foreground="{DynamicResource C.F1F5F9}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
													<TextBlock Grid.Column="3" Text="{Binding Actions.Count}" FontSize="11" Foreground="{DynamicResource C.64748B}" VerticalAlignment="Center" />
												</Grid>
											</ToggleButton>
											<ItemsControl ItemsSource="{Binding Actions}" IsVisible="{Binding IsExpanded}" Margin="16,0,0,6">
												<ItemsControl.ItemTemplate>
													<DataTemplate x:DataType="vm:ActionItemViewModel">
														<Border Classes="actionItem"
																Padding="10,7"
																CornerRadius="8"
																Cursor="Hand"
																ToolTip.Tip="{Binding Summary}"
																PointerPressed="ActionCard_OnPointerPressed">
															<Grid ColumnDefinitions="22,*" ColumnSpacing="10">
																<Panel Width="22" Height="22">
																	<Viewbox IsVisible="{Binding Icon.HasGeometry}">
																		<Canvas Width="24" Height="24"><Path Data="{Binding Icon.Geometry}" Fill="{Binding Icon.Brush}" /></Canvas>
																	</Viewbox>
																	<Image Source="{Binding Icon.Image}" IsVisible="{Binding Icon.HasImage}" Stretch="Uniform" />
																</Panel>
																<TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{DynamicResource C.E2E8F0}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
															</Grid>
														</Border>
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</ScrollViewer>
					</Grid>
				</Border>
			</Grid>

			<!-- Pages (settings, plugins, profiles, updates) open here, over the workspace. -->
			<Border Grid.Row="1" x:Name="PageHost" IsVisible="False" Background="{DynamicResource C.111318}">
				<Grid RowDefinitions="Auto,*">
					<Border Padding="12,8" Background="{DynamicResource C.16181E}" BorderBrush="{DynamicResource C.262B36}" BorderThickness="0,0,0,1">
						<StackPanel Orientation="Horizontal" Spacing="12">
							<Button Classes="tool" Click="PageBack_OnClick" ToolTip.Tip="Back">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Classes="toolIcon" Data="F0 M15.5 4L17 5.5L10.5 12L17 18.5L15.5 20L7.5 12Z" /></Canvas></Viewbox>
									<TextBlock Text="Back" VerticalAlignment="Center" Foreground="{DynamicResource C.CBD5E1}" />
								</StackPanel>
							</Button>
							<TextBlock x:Name="PageTitle" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" VerticalAlignment="Center" />
						</StackPanel>
					</Border>
					<!-- Pages keep a readable width on a wide window. -->
					<ContentControl Grid.Row="1" x:Name="PageContent" MaxWidth="1100" HorizontalAlignment="Stretch" />
				</Grid>
			</Border>
		</Grid>

		<!-- The drag ghost: what is being dragged (the action's icon and name) follows the pointer. -->
		<Canvas x:Name="DragLayer" IsHitTestVisible="False">
			<Border x:Name="DragGhostVisual" IsVisible="False" Padding="10,7" CornerRadius="10" Background="{DynamicResource C.E61E222B}" BorderBrush="{DynamicResource C.3B82F6}" BorderThickness="1"
					BoxShadow="0 6 18 0 #80000000">
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Panel Width="22" Height="22">
						<Viewbox x:Name="DragGhostIconBox">
							<Canvas Width="24" Height="24"><Path x:Name="DragGhostPath" /></Canvas>
						</Viewbox>
						<Image x:Name="DragGhostImage" Stretch="Uniform" />
					</Panel>
					<TextBlock x:Name="DragGhostText" Foreground="{DynamicResource C.F8FAFC}" FontWeight="SemiBold" VerticalAlignment="Center" />
				</StackPanel>
			</Border>
		</Canvas>
	</Panel>
</Window>
