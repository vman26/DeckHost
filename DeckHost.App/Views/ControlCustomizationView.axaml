<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:local="using:DeckHost.App.Views"
		x:Class="DeckHost.App.Views.ControlCustomizationView"
		x:DataType="vm:ControlCustomizationViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
		</Style>
		<Style Selector="TextBlock.label">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.E2E8F0}" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.error">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource C.FCA5A5}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
	</UserControl.Styles>

	<UserControl.DataTemplates>
		<!-- One editor per setting kind; the fields come from the action's setting definitions. -->
		<DataTemplate DataType="vm:TextSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:SecretSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<TextBox Text="{Binding Value, Mode=TwoWay}" PasswordChar="•" PlaceholderText="{Binding Placeholder}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:NumberSettingField">
			<local:NumberSettingEditor />
		</DataTemplate>
		<DataTemplate DataType="vm:ToggleSettingField">
			<StackPanel Spacing="4">
				<CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:ChoiceSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<ComboBox ItemsSource="{Binding Options}"
						  SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
						  HorizontalAlignment="Stretch"
						  DisplayMemberBinding="{Binding Label}" />
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:FilePathSettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" />
					<Button Grid.Column="1" Content="Browse…" Click="BrowseSettingFile_OnClick" />
				</Grid>
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:HotkeySettingField">
			<StackPanel Spacing="4">
				<TextBlock Classes="label" Text="{Binding Label}" />
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
					<TextBox Text="{Binding Value, Mode=TwoWay}" PlaceholderText="{Binding Placeholder}" IsReadOnly="{Binding IsRecording}" />
					<ToggleButton Grid.Column="1"
								  MinWidth="80"
								  Content="{Binding RecordButtonText}"
								  IsChecked="{Binding IsRecording, Mode=TwoWay}"
								  IsCheckedChanged="HotkeyRecord_OnIsCheckedChanged" />
				</Grid>
				<Border IsVisible="{Binding ShowRecordingHint}" Background="{DynamicResource C.1E3A8A}" CornerRadius="8" Padding="10,6">
					<TextBlock Foreground="{DynamicResource C.DBEAFE}" TextWrapping="Wrap">
						<Run Text="Press the key combination now (Esc cancels). " />
						<Run Text="{Binding RecordingPreview}" FontWeight="SemiBold" />
					</TextBlock>
				</Border>
				<TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
				<TextBlock Classes="error" Text="{Binding Error}" IsVisible="{Binding HasError}" />
			</StackPanel>
		</DataTemplate>
		<DataTemplate DataType="vm:SettingsEditorViewModel">
			<ItemsControl ItemsSource="{Binding Fields}">
				<ItemsControl.ItemsPanel>
					<ItemsPanelTemplate>
						<StackPanel Spacing="12" />
					</ItemsPanelTemplate>
				</ItemsControl.ItemsPanel>
				<!-- A heading above each input's group (a knob: when pressed / turned left / turned right);
				     settings that don't apply right now are hidden. The field itself uses its own template. -->
				<ItemsControl.Styles>
					<!-- On the item container, so a hidden setting takes no spacing either. -->
					<Style Selector="ContentPresenter" x:DataType="vm:SettingFieldViewModel">
						<Setter Property="IsVisible" Value="{Binding IsVisible}" />
					</Style>
				</ItemsControl.Styles>
				<ItemsControl.ItemTemplate>
					<DataTemplate x:DataType="vm:SettingFieldViewModel">
						<StackPanel Spacing="6">
							<TextBlock Text="{Binding SectionTitle}" IsVisible="{Binding HasSectionTitle}"
									   FontWeight="SemiBold" Foreground="{DynamicResource C.93C5FD}" Margin="0,6,0,0" />
							<ContentControl Content="{Binding}" />
						</StackPanel>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid RowDefinitions="Auto,*">
		<!-- Which control is being edited; edits apply right away. -->
		<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Margin="20,14,20,6">
			<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
				<TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" VerticalAlignment="Center" />
				<TextBlock Text="{Binding ControlType}" Foreground="{DynamicResource C.64748B}" VerticalAlignment="Center" />
			</StackPanel>
			<TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="Changes show on the device right away." />
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button Content="Revert" ToolTip.Tip="Put back how this control was when you selected it" Command="{Binding RevertCommand}" />
				<Button Content="Remove" ToolTip.Tip="Remove the action from this control" Command="{Binding RemoveCommand}" IsVisible="{Binding HasAssignment}" />
			</StackPanel>
		</Grid>

		<!-- Two columns side by side when there is room (code-behind switches to one). -->
		<Grid Grid.Row="1" Name="Columns" ColumnDefinitions="*,*" ColumnSpacing="14" Margin="20,8,20,20">
			<StackPanel Name="PrimaryColumn" Spacing="14">
				<!-- Action and its settings -->
				<Border Classes="card" IsVisible="{Binding HasAction}">
					<StackPanel Spacing="12">
						<StackPanel Spacing="2">
							<TextBlock Classes="section" Text="ACTION" />
							<TextBlock Text="{Binding ActionName}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
							<TextBlock Text="{Binding ActionPluginName}" Classes="hint" />
							<TextBlock Text="{Binding ActionDescription}" Classes="hint" IsVisible="{Binding HasActionDescription}" />
						</StackPanel>
						<ContentControl Content="{Binding ActionSettings}" IsVisible="{Binding HasActionSettings}" />
						<StackPanel Spacing="8" IsVisible="{Binding IsWorkflow}">
							<TextBlock Text="{Binding WorkflowSummary}" Foreground="{DynamicResource C.E2E8F0}" TextWrapping="Wrap" />
							<Button Content="Open workflow editor" Classes="accent" Command="{Binding OpenWorkflowCommand}" HorizontalAlignment="Left"
									ToolTip.Tip="Link triggers, actions, waits, conditions and loops on a canvas" />
						</StackPanel>
						<Button Content="Turn into a workflow…" Command="{Binding ConvertToWorkflowCommand}" IsVisible="{Binding CanConvertToWorkflow}" HorizontalAlignment="Left"
								ToolTip.Tip="Make a workflow that does the same, to add conditions (If), loops, toggles and variables" />
						<Button Content="Open folder" Classes="accent" Command="{Binding OpenFolderCommand}" IsVisible="{Binding IsFolder}" HorizontalAlignment="Left"
								ToolTip.Tip="Show the folder's keys here (and on the device); Back under the device returns" />
						<TextBlock Classes="hint" IsVisible="{Binding ShowSettingsPage}"
								   Text="This plugin has its own settings, shown on the right. They are saved straight to the plugin." />
					</StackPanel>
				</Border>

				<!-- Multi Action steps: drop actions from the list to add them at a place, drag ⠿ to reorder. -->
				<Border Classes="card" IsVisible="{Binding IsMultiAction}">
					<StackPanel Spacing="10">
						<TextBlock Classes="section" Text="{Binding StepsTitle}" />
						<TextBlock Classes="hint" Text="Drag actions from the list onto the steps to add them where you drop them; drag ⠿ to change the order." />
						<Border Name="StepsDropZone" Background="{DynamicResource C.0B1120}" BorderBrush="{DynamicResource C.334155}" BorderThickness="1" CornerRadius="10" Padding="8" MinHeight="64"
								DragDrop.AllowDrop="True">
							<StackPanel Spacing="0">
								<TextBlock Classes="hint" IsVisible="{Binding HasNoSteps}" Margin="8,14" HorizontalAlignment="Center"
										   Text="No steps yet: drop an action here." />
								<ItemsControl Name="StepsList" ItemsSource="{Binding Steps}">
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="vm:MultiActionStepEditorViewModel">
											<StackPanel>
												<!-- Where a dragged action or step lands. -->
												<Border Height="3" Margin="4,2" CornerRadius="2" Background="{DynamicResource C.3B82F6}" IsVisible="{Binding IsDropBefore}" />
												<Border Background="{DynamicResource C.111827}" BorderBrush="{DynamicResource C.334155}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,3">
													<StackPanel Spacing="10">
														<Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
															<TextBlock Text="⠿" FontSize="18" Foreground="{DynamicResource C.64748B}" VerticalAlignment="Center" Cursor="SizeAll"
																	   Background="Transparent" ToolTip.Tip="Drag to reorder" PointerPressed="StepHandle_OnPointerPressed" />
															<Border Grid.Column="1" Width="28" Height="28" CornerRadius="7" Background="{DynamicResource C.1E293B}">
																<TextBlock Text="{Binding Position}" FontWeight="SemiBold" Foreground="{DynamicResource C.93C5FD}" HorizontalAlignment="Center" VerticalAlignment="Center" />
															</Border>
															<StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
																<TextBlock Text="{Binding Action.Name}" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
																<TextBlock Text="{Binding PluginName}" Classes="hint" />
															</StackPanel>
															<Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Center" />
														</Grid>
														<!-- Which set it's in (switch, key logic) and how long it waits first. -->
														<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
															<TextBlock Text="Runs on" Classes="hint" VerticalAlignment="Center" IsVisible="{Binding HasGroup}" />
															<ComboBox Grid.Column="1" ItemsSource="{Binding GroupOptions}" SelectedItem="{Binding Group, Mode=TwoWay}"
																	  DisplayMemberBinding="{Binding Label}" MinWidth="140" IsVisible="{Binding HasGroup}" />
															<TextBlock Grid.Column="3" Text="Wait before (ms)" Classes="hint" VerticalAlignment="Center" />
															<NumericUpDown Grid.Column="4" Value="{Binding Delay, Mode=TwoWay}" Minimum="0" Maximum="60000" Increment="100"
																		   FormatString="0" Width="130" ToolTip.Tip="Waits this long before the step runs; the device keeps working meanwhile" />
														</Grid>
														<ContentControl Content="{Binding Settings}" IsVisible="{Binding HasSettings}" />
													</StackPanel>
												</Border>
											</StackPanel>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
								<Border Height="3" Margin="4,2" CornerRadius="2" Background="{DynamicResource C.3B82F6}" IsVisible="{Binding IsDropAtEnd}" />
							</StackPanel>
						</Border>
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
							<ComboBox ItemsSource="{Binding AvailableStepActions}"
									  SelectedItem="{Binding SelectedStepAction, Mode=TwoWay}"
									  HorizontalAlignment="Stretch"
									  PlaceholderText="Or choose an action">
								<ComboBox.ItemTemplate>
									<DataTemplate x:DataType="vm:ActionItemViewModel">
										<TextBlock>
											<Run Text="{Binding Name}" />
											<Run Text="  ·  " Foreground="{DynamicResource C.64748B}" />
											<Run Text="{Binding PluginName}" Foreground="{DynamicResource C.64748B}" />
										</TextBlock>
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>
							<Button Grid.Column="1" Content="Add step" Classes="accent" Command="{Binding AddStepCommand}" />
						</Grid>
					</StackPanel>
				</Border>

				<!-- The plugin's own settings page (Stream Deck property inspector), shown in the built-in browser. -->
		<Border Height="460" IsVisible="{Binding ShowSettingsPage}" Background="{DynamicResource C.2D2D2D}" BorderBrush="{DynamicResource C.1E293B}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
			<Grid RowDefinitions="Auto,*">
				<DockPanel Margin="12,8">
					<Button DockPanel.Dock="Right" Content="Open in browser" Padding="10,2" FontSize="12" Command="{Binding OpenSettingsPageInBrowserCommand}" />
					<TextBlock Text="Plugin settings" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" VerticalAlignment="Center" />
				</DockPanel>
				<NativeWebView Grid.Row="1" Name="SettingsBrowser" Source="{Binding SettingsPageUri}" />
				<TextBlock Grid.Row="1" Name="SettingsBrowserError" IsVisible="False" Margin="12" Foreground="{DynamicResource C.FCA5A5}" TextWrapping="Wrap" />
			</Grid>
		</Border>
				<TextBlock Classes="hint" IsVisible="{Binding ShowNothingToCustomize}"
						   Text="This control has no display, settings or light to customize." />
			</StackPanel>
			<StackPanel Name="SecondaryColumn" Grid.Column="1" Spacing="14">
				<!-- Text and image -->
				<Border Classes="card" IsVisible="{Binding SupportsAppearance}">
					<StackPanel Spacing="10">
						<TextBlock Classes="section" Text="DISPLAY" />
						<!-- A control without a display of its own (a knob) shows itself on the one next to it. -->
						<StackPanel Spacing="4" IsVisible="{Binding HasLinkedDisplay}">
							<CheckBox Content="{Binding ShowOnLinkedDisplayLabel}" IsChecked="{Binding ShowOnLinkedDisplay}" />
							<TextBlock Classes="hint" Text="{Binding LinkedDisplayHint}" />
						</StackPanel>
						<TextBlock Classes="label" Text="Text" />
						<TextBox Name="DisplayTextBox"
								 Text="{Binding DisplayText, Mode=TwoWay}"
								 AcceptsReturn="True"
								 TextWrapping="Wrap"
								 MinHeight="56"
								 PlaceholderText="Optional; replaces the action's own label. Press Enter for a new line." />
						<TextBlock Classes="label" Text="Background" />
						<ComboBox ItemsSource="{Binding BackgroundModes}" SelectedItem="{Binding SelectedBackgroundMode, Mode=TwoWay}"
								  DisplayMemberBinding="{Binding Label}" HorizontalAlignment="Stretch" />
						<local:ColorField Hex="{Binding BackgroundColor, Mode=TwoWay}" DefaultHex="#1E293B" Placeholder="a color of your own" AllowOpacity="True"
										  IsVisible="{Binding ShowBackgroundColor}" />
						<!-- The tile's look: colors (one, or a gradient) and corner rounding. -->
						<Grid IsVisible="{Binding ShowTileSettings}" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
							<TextBlock Text="Color" VerticalAlignment="Center" Foreground="{DynamicResource C.CBD5E1}" />
							<local:ColorField Grid.Column="1" Hex="{Binding TileFrom, Mode=TwoWay}" DefaultHex="#64748B" Placeholder="the action's colors" AllowOpacity="True" />
							<TextBlock Grid.Row="1" Text="Fades to" VerticalAlignment="Center" Foreground="{DynamicResource C.CBD5E1}" />
							<local:ColorField Grid.Row="1" Grid.Column="1" Hex="{Binding TileTo, Mode=TwoWay}" DefaultHex="#1E293B" Placeholder="one color (or the action's gradient)" AllowOpacity="True" />
							<TextBlock Grid.Row="2" Text="Corners" VerticalAlignment="Center" Foreground="{DynamicResource C.CBD5E1}" />
							<Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,64" ColumnSpacing="8">
								<Slider Minimum="0" Maximum="50" SmallChange="2" LargeChange="10" Value="{Binding TileCorner, Mode=TwoWay}" VerticalAlignment="Center" />
								<TextBlock Grid.Column="1" Text="{Binding TileCornerText}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource C.E2E8F0}" />
							</Grid>
							<Button Grid.Row="3" Grid.Column="1" Content="Back to the action's tile" Command="{Binding ResetTileCommand}" HorizontalAlignment="Left" />
						</Grid>
						<TextBlock Classes="hint" Text="Transparent shows the profile background behind the icon. A color can be partly see-through with its opacity slider." />
						<TextBlock Classes="error" Text="{Binding BackgroundColorError}" IsVisible="{Binding HasBackgroundColorError}" />
						<TextBlock Classes="label" Text="Icon" />
						<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
							<TextBlock Text="{Binding IconName}" VerticalAlignment="Center" Foreground="{DynamicResource C.E2E8F0}" TextTrimming="CharacterEllipsis" />
							<Button Grid.Column="1" Content="Choose…" Click="ChooseIcon_OnClick" />
							<Button Grid.Column="2" Content="Clear" Command="{Binding ClearIconCommand}" IsEnabled="{Binding HasIcon}" />
						</Grid>
						<TextBlock Classes="hint" Text="From your icon packs or Iconify's free icon sets. It takes the place of the action's own icon on its tile; single-color icons are drawn in white." />
						<TextBlock Classes="label" Text="Image (PNG, JPG, SVG or animated GIF)" />
						<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
							<TextBox Name="ImagePathTextBox"
									 Text="{Binding ImagePath, Mode=TwoWay}"
									 PlaceholderText="Optional image file" />
							<Button Grid.Column="1" Content="Browse…" Click="BrowseImage_OnClick" />
							<Button Grid.Column="2" Content="Clear" Command="{Binding ClearImageCommand}" />
						</Grid>
					</StackPanel>
				</Border>

				<!-- Text style -->
				<Border Classes="card" IsVisible="{Binding SupportsAppearance}">
					<StackPanel Spacing="10">
						<TextBlock Classes="section" Text="TEXT STYLE" />
						<Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
							<TextBlock Classes="label" Text="Color" />
							<TextBlock Classes="label" Grid.Column="1" Text="Size (px)" />
							<local:ColorField Grid.Row="1" Hex="{Binding TextColor, Mode=TwoWay}" DefaultHex="#FFFFFF" Placeholder="action default" />
							<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FontSizeText, Mode=TwoWay}" PlaceholderText="Automatic" />
							<TextBlock Classes="label" Grid.Row="2" Text="Horizontal" />
							<TextBlock Classes="label" Grid.Row="2" Grid.Column="1" Text="Vertical" />
							<ComboBox Grid.Row="3" ItemsSource="{Binding HorizontalOptions}" SelectedItem="{Binding Horizontal, Mode=TwoWay}" HorizontalAlignment="Stretch" />
							<ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding VerticalOptions}" SelectedItem="{Binding Vertical, Mode=TwoWay}" HorizontalAlignment="Stretch" />
						</Grid>
						<TextBlock Classes="label" Text="Font" />
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
							<AutoCompleteBox Name="FontBox"
											 ItemsSource="{Binding FontFamilies}"
											 Text="{Binding FontFamily, Mode=TwoWay}"
											 FilterMode="ContainsOrdinal"
											 MinimumPrefixLength="0"
											 MaxDropDownHeight="320"
											 GotFocus="FontBox_OnGotFocus"
											 PlaceholderText="Default font (type to search, or open the list)" />
							<Button Grid.Column="1" Content="▾" Padding="10,4" ToolTip.Tip="Show all installed fonts" Click="FontList_OnClick" />
						</Grid>
						<WrapPanel ItemSpacing="16">
							<CheckBox Content="Bold" IsChecked="{Binding Bold}" />
							<CheckBox Content="Italic" IsChecked="{Binding Italic}" />
							<CheckBox Content="Wrap long lines" IsChecked="{Binding Wrap}" />
						</WrapPanel>
					</StackPanel>
				</Border>

				<!-- LED -->
				<Border Classes="card" IsVisible="{Binding SupportsLight}">
					<StackPanel Spacing="10">
						<TextBlock Classes="section" Text="LIGHT" />
						<TextBlock Classes="hint" IsVisible="{Binding ShowLightNeedsAction}"
								   Text="Assign an action to this control first; the light reacts when the action runs." />
						<StackPanel Spacing="10" IsVisible="{Binding ShowLightEditor}">
							<CheckBox Content="Its own light (instead of the Knob lights in Device Settings)" IsChecked="{Binding LightEnabled}" />
							<StackPanel Spacing="6" IsEnabled="{Binding LightEnabled}">
								<TextBlock Classes="label" Text="While idle" />
								<local:LightStyleEditor DataContext="{Binding IdleLight}" />
							</StackPanel>
							<Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4" IsEnabled="{Binding LightEnabled}" Margin="0,6,0,0">
								<TextBlock Classes="label" Text="When used" />
								<TextBlock Classes="label" Grid.Column="1" Text="for (ms)" />
								<local:ColorField Grid.Row="1" Hex="{Binding ActiveColor, Mode=TwoWay}" DefaultHex="#00FF00" />
								<TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ActiveDurationText, Mode=TwoWay}" PlaceholderText="200" />
							</Grid>
							<CheckBox Content="Blink instead of a steady color" IsEnabled="{Binding LightEnabled}" IsChecked="{Binding PulseOnActive}" />
							<TextBlock Classes="error" Text="{Binding LightError}" IsVisible="{Binding HasLightError}" />
						</StackPanel>
					</StackPanel>
				</Border>

			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
