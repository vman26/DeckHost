<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		x:Class="DeckHost.App.Views.AppSettingsView"
		x:DataType="vm:AppSettingsViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="#94A3B8" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="28,0,0,0" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="#0F172A" />
			<Setter Property="BorderBrush" Value="#1E293B" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
	<StackPanel Margin="20" Spacing="14">

		<Border Classes="card">
			<StackPanel Spacing="10">
				<CheckBox Content="Start DeckHost when I sign in" IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding CanStartAtLogin}" />
				<TextBlock Classes="hint" Text="Adds DeckHost to your user's start-up programs, so your device works right after sign-in." />
				<CheckBox Content="Start in the tray when started at sign-in" IsChecked="{Binding StartMinimized}" />
				<TextBlock Classes="hint" Text="The device works without the window. Open DeckHost from the tray icon." />
				<CheckBox Content="Closing the window keeps DeckHost running in the tray" IsChecked="{Binding CloseToTray}" />
				<TextBlock Classes="hint" Text="Use Exit in the tray menu to quit. When off, closing the window stops DeckHost and blanks the device." />
			</StackPanel>
		</Border>

		<Border Classes="card" IsVisible="{Binding HasUpdates}">
			<StackPanel Spacing="10" DataContext="{Binding Updates}" x:DataType="vm:UpdateViewModel">
				<TextBlock Text="Updates" FontWeight="SemiBold" Foreground="#E2E8F0" />
				<TextBlock Text="{Binding CurrentVersionText}" FontSize="12" Foreground="#94A3B8" />
				<CheckBox Content="Check for updates automatically" IsChecked="{Binding CheckAutomatically}" />
				<TextBlock Classes="hint" Text="A little after start and every few hours, DeckHost asks GitHub for a new release and shows a notice when there is one." />
				<CheckBox Content="Include pre-releases" IsChecked="{Binding IncludePrereleases}" />
				<TextBlock Classes="hint" Text="Alpha, beta and release-candidate builds: new features sooner, with more rough edges." />
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<Button Content="Check now" Command="{Binding CheckNowCommand}" />
						<Button Content="What's new…" Classes="accent" Command="{Binding ShowDetailsCommand}" IsVisible="{Binding IsUpdateAvailable}" />
					</StackPanel>
					<Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
						<ProgressBar IsIndeterminate="True" Width="60" MinWidth="60" IsVisible="{Binding IsChecking}" />
						<TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" Foreground="#93C5FD" TextWrapping="Wrap" VerticalAlignment="Center" />
					</Grid>
				</Grid>
			</StackPanel>
		</Border>

		<Border Classes="card">
			<StackPanel Spacing="10">
				<CheckBox Content="Show the debug panel" IsChecked="{Binding ShowDebugPanel}" />
				<TextBlock Classes="hint" Text="Next to the editor: the selected control's inputs and outputs, the runtime connection and the runtime log." />
			</StackPanel>
		</Border>

		<Border Classes="card">
			<StackPanel Spacing="8">
				<SelectableTextBlock Text="{Binding VersionText}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap" />
				<TextBlock Text="Data" FontWeight="SemiBold" Foreground="#E2E8F0" />
				<SelectableTextBlock Text="{Binding DataDirectory}" Foreground="#CBD5E1" TextWrapping="Wrap" />
				<StackPanel Orientation="Horizontal" Spacing="8">
					<Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" />
					<Button Content="Open logs folder" Command="{Binding OpenLogFolderCommand}" />
				</StackPanel>
			</StackPanel>
		</Border>

		<TextBlock Text="{Binding Status}" IsVisible="{Binding HasStatus}" Foreground="#93C5FD" TextWrapping="Wrap" />
	</StackPanel>
	</ScrollViewer>
</UserControl>
