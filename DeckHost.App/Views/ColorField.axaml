<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 x:Class="DeckHost.App.Views.ColorField">
	<UserControl.Styles>
		<!-- Not set: the default color is shown muted, so the box is never blank. -->
		<Style Selector="TextBox.isDefault">
			<Setter Property="Foreground" Value="#64748B" />
			<Setter Property="FontStyle" Value="Italic" />
		</Style>
	</UserControl.Styles>
	<StackPanel Spacing="6">
		<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
			<ColorPicker Name="Picker"
						 IsAlphaEnabled="False"
						 IsAlphaVisible="False"
						 VerticalAlignment="Center" />
			<TextBox Name="HexBox" Grid.Column="1" />
			<Button Name="ClearButton" Grid.Column="2" Content="✕" ToolTip.Tip="Back to the default" Padding="8,4" />
		</Grid>
		<!-- Only with AllowOpacity: 0 % is transparent (what is behind shows through). -->
		<Grid Name="OpacityRow" ColumnDefinitions="Auto,*,48,Auto" ColumnSpacing="8" IsVisible="False">
			<TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="#94A3B8" />
			<Slider Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
					TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
			<TextBlock Name="OpacityText" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#E2E8F0" />
			<Button Name="TransparentButton" Grid.Column="3" Content="Transparent" Padding="8,4"
					ToolTip.Tip="No background of its own: the profile background shows through" />
		</Grid>
	</StackPanel>
</UserControl>
