<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:local="using:DeckHost.App.Views"
		x:Class="DeckHost.App.Views.ProfileManagerView"
		x:DataType="vm:ProfileManagerViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
		</Style>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="Auto,*">
		<Border Padding="20,16" Background="{DynamicResource C.0F172A}" BorderBrush="{DynamicResource C.1E293B}" BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
				<StackPanel Spacing="4">
					<TextBlock Text="Profile Manager" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
					<TextBlock Classes="hint" Text="Profiles are the pages of your device. Give a profile one or more apps and it turns on by itself while that app is in front." />
					<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
						<Button Content="Profiles" Command="{Binding ShowProfilesCommand}" Classes.accent="{Binding IsProfilesSection}" />
						<Button Content="Default background" Command="{Binding ShowDefaultBackgroundCommand}" Classes.accent="{Binding IsDefaultSection}" />
						<Button Content="Backups" Command="{Binding ShowBackupsCommand}" Classes.accent="{Binding IsBackupsSection}" />
					</StackPanel>
				</StackPanel>
				<StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
					<ToggleSwitch IsChecked="{Binding AutoSwitchEnabled}"
								  IsEnabled="{Binding AutoSwitchSupported}"
								  OnContent="Switch profiles automatically"
								  OffContent="Switch profiles automatically" />
					<TextBlock Classes="hint" HorizontalAlignment="Right">
						<Run Text="Active app: " />
						<Run Text="{Binding CurrentAppName}" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
					</TextBlock>
					<TextBlock Classes="hint" IsVisible="{Binding AutoSwitchUnsupported}" Text="{Binding AutoSwitchUnsupportedReason}" />
				</StackPanel>
			</Grid>
		</Border>

		<Grid Grid.Row="1" ColumnDefinitions="300,*" Margin="20" ColumnSpacing="16" IsVisible="{Binding IsProfilesSection}">
			<!-- Profile list -->
			<Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
				<TextBlock Classes="section" Text="PROFILES (NEXT/PREVIOUS USE THIS ORDER)" />
				<ListBox Grid.Row="1"
						 ItemsSource="{Binding Profiles}"
						 SelectedItem="{Binding EditingProfile, Mode=TwoWay}"
						 Background="{DynamicResource C.0F172A}"
						 CornerRadius="12">
					<ListBox.ItemTemplate>
						<DataTemplate x:DataType="vm:ProfileItemViewModel">
							<StackPanel Spacing="2" Margin="2,4">
								<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
								<TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{DynamicResource C.94A3B8}" />
								<TextBlock Text="{Binding AutoSwitchSummary}" FontSize="11" Foreground="{DynamicResource C.93C5FD}" TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
				<WrapPanel Grid.Row="2" ItemSpacing="6" LineSpacing="6">
					<Button Content="New" Classes="accent" Command="{Binding NewProfileCommand}" />
					<Button Content="Duplicate" Command="{Binding DuplicateProfileCommand}" IsEnabled="{Binding HasEditingProfile}" />
					<Button Content="↑" ToolTip.Tip="Move up" Command="{Binding MoveUpCommand}" IsEnabled="{Binding HasEditingProfile}" />
					<Button Content="↓" ToolTip.Tip="Move down" Command="{Binding MoveDownCommand}" IsEnabled="{Binding HasEditingProfile}" />
					<Button Content="Import…" ToolTip.Tip="A DeckHost profile (.deckhostprofile) or a Stream Deck profile (.streamDeckProfile)" Click="ImportProfile_OnClick" />
					<Button Content="Export…" ToolTip.Tip="This profile with its pages, folders and images, to share or keep" Click="ExportProfile_OnClick" IsEnabled="{Binding HasEditingProfile}" />
					<StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasOtherDevices}">
						<Button Content="Copy to" Command="{Binding CopyToDeviceCommand}" IsEnabled="{Binding HasEditingProfile}"
								ToolTip.Tip="A copy of this profile for another device: keys keep their place where they fit, the rest go on added pages" />
						<ComboBox ItemsSource="{Binding OtherDevices}" SelectedItem="{Binding CopyTarget}" MinWidth="150">
							<ComboBox.ItemTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Label}" />
								</DataTemplate>
							</ComboBox.ItemTemplate>
						</ComboBox>
					</StackPanel>
				</WrapPanel>
			</Grid>

			<!-- Details -->
			<ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasEditingProfile}">
				<StackPanel Spacing="14">
					<!-- After a Stream Deck import: the plugins it uses that aren't installed. -->
					<Border Classes="card" IsVisible="{Binding MissingPlugins.HasItems}" BorderBrush="{DynamicResource C.1E3A8A}">
						<StackPanel Spacing="10">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<StackPanel Spacing="2">
									<TextBlock Text="{Binding MissingPlugins.Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource C.F8FAFC}" TextWrapping="Wrap" />
									<TextBlock Classes="hint" Text="Their keys kept their title and image and are marked on the device. Install a plugin and its keys work again by themselves." />
								</StackPanel>
								<Button Grid.Column="1" Content="✕" ToolTip.Tip="Hide this list" Command="{Binding MissingPlugins.DismissCommand}" VerticalAlignment="Top" />
							</Grid>
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding MissingPlugins.HasStoreStatus}">
								<TextBlock Classes="hint" Text="{Binding MissingPlugins.StoreStatus}" VerticalAlignment="Center" />
								<Button Grid.Column="1" Content="Try again" Command="{Binding MissingPlugins.RetryCommand}" IsVisible="{Binding !MissingPlugins.IsLoadingStore}" />
							</Grid>
							<ItemsControl ItemsSource="{Binding MissingPlugins.Items}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:MissingPluginItemViewModel">
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4">
											<StackPanel Spacing="2">
												<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Id}" FontSize="11" Foreground="{DynamicResource C.94A3B8}" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource C.94A3B8}" />
												<TextBlock Classes="hint" Text="{Binding SearchHint}" IsVisible="{Binding IsNotInStore}" />
												<TextBlock Classes="hint" Text="{Binding ElsewhereText}" IsVisible="{Binding RunsElsewhere}" />
												<TextBlock Text="{Binding Progress}" IsVisible="{Binding HasProgress}" FontSize="12" Foreground="{DynamicResource C.93C5FD}" TextWrapping="Wrap" />
											</StackPanel>
											<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
												<Button Content="Install" Classes="accent" Command="{Binding InstallCommand}" IsVisible="{Binding ShowInstall}" />
												<Button Content="Buy…" Command="{Binding BuyCommand}" IsVisible="{Binding ShowBuy}" />
												<Button Content="Search…" Command="{Binding SearchCommand}" IsVisible="{Binding IsNotInStore}" ToolTip.Tip="Search the Elgato Marketplace in the browser" />
											</StackPanel>
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>
					<TextBlock Classes="hint" Text="{Binding Message}" IsVisible="{Binding HasMessage}" Foreground="{DynamicResource C.93C5FD}" />

					<Border Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="section" Text="PROFILE" />
							<TextBlock Text="Name" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
							<TextBox Text="{Binding EditingName, Mode=TwoWay}" />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Content="Use now" Classes="accent" Command="{Binding UseNowCommand}" IsVisible="{Binding !IsEditingActiveProfile}" />
								<Border IsVisible="{Binding IsEditingActiveProfile}" Background="{DynamicResource C.14532D}" CornerRadius="999" Padding="10,4" VerticalAlignment="Center">
									<TextBlock Text="Active on the device" FontSize="12" Foreground="{DynamicResource C.BBF7D0}" />
								</Border>
								<Button Content="{Binding DeleteButtonText}" Command="{Binding DeleteProfileCommand}" IsEnabled="{Binding CanDelete}" />
							</StackPanel>
						</StackPanel>
					</Border>

					<Border Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="section" Text="BACKGROUND OF THIS PROFILE" />
							<CheckBox IsChecked="{Binding EditingOverridesBackground, Mode=TwoWay}" Content="Use a background of its own (override the default)" />
							<TextBlock Classes="hint" IsVisible="{Binding !EditingOverridesBackground}" TextWrapping="Wrap" Text="This profile shows the default background (Default background, above). Tick the box to give it its own; what you set stays when you untick it." />
							<StackPanel Spacing="10" IsVisible="{Binding EditingOverridesBackground}">
							<local:BackgroundPreviewView DataContext="{Binding ProfilePreview}" />
							<TextBlock Classes="hint" Text="Shown behind every control of this profile. An image spans the whole device, so each key shows its own part of it. Animated GIFs play (about 10 frames per second)." />
							<TextBlock Text="Color" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
							<local:ColorField Hex="{Binding EditingBackgroundColor, Mode=TwoWay}" DefaultHex="#0B1220" Placeholder="DeckHost dark blue" Width="280" HorizontalAlignment="Left" />
							<TextBlock Text="{Binding BackgroundColorError}" IsVisible="{Binding HasBackgroundColorError}" Foreground="{DynamicResource C.FCA5A5}" FontSize="12" />
							<TextBlock Text="Image (PNG, JPG, SVG or animated GIF)" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
								<TextBox Text="{Binding EditingBackgroundImage, Mode=TwoWay}" PlaceholderText="Optional image file" />
								<Button Grid.Column="1" Content="Browse…" Click="BrowseBackground_OnClick" />
								<Button Grid.Column="2" Content="Clear" Command="{Binding ClearBackgroundCommand}" />
							</Grid>
							<local:BackgroundLayersEditor DataContext="{Binding ProfileLayers}" Margin="0,6,0,0" />
							</StackPanel>
						</StackPanel>
					</Border>

					<Border Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="section" Text="SWITCH TO THIS PROFILE WHEN THESE APPS ARE IN FRONT" />
							<TextBlock Classes="hint" Text="When the focused app isn't listed in any profile, DeckHost goes back to the profile you picked yourself. DeckHost's own windows never trigger a switch." />
							<TextBlock Classes="hint" Text="Add a window title after a bar to switch on it: chrome | *YouTube* (only YouTube tabs), * | *Zoom Meeting* (any app). * matches any text and ? one character, also in app names: steam_app_* for every Steam game. A rule with a title wins over one without. Window titles are read on Windows and Linux (X11)." />
							<ItemsControl ItemsSource="{Binding EditingProfile.AutoSwitchApps}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel ItemSpacing="6" LineSpacing="6" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="x:String">
										<Border Background="{DynamicResource C.1E3A8A}" CornerRadius="999" Padding="10,2,4,2">
											<StackPanel Orientation="Horizontal" Spacing="4">
												<TextBlock Text="{Binding}" Foreground="{DynamicResource C.DBEAFE}" VerticalAlignment="Center" />
												<Button Content="✕"
														Padding="6,0"
														Background="Transparent"
														ToolTip.Tip="Remove"
														Command="{Binding $parent[UserControl].((vm:ProfileManagerViewModel)DataContext).RemoveAppCommand}"
														CommandParameter="{Binding}" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

							<TextBlock Text="Add an app" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" Margin="0,6,0,0" />
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
								<ComboBox ItemsSource="{Binding RunningApps}"
										  SelectedItem="{Binding SelectedRunningApp, Mode=TwoWay}"
										  PlaceholderText="Pick a running app"
										  HorizontalAlignment="Stretch" />
								<Button Grid.Column="1" Content="Add" Command="{Binding AddRunningAppCommand}" />
								<Button Grid.Column="2" Content="↻" ToolTip.Tip="Refresh the list" Command="{Binding RefreshRunningAppsCommand}" />
							</Grid>
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
								<TextBox Text="{Binding NewAppName, Mode=TwoWay}" PlaceholderText="Or type a process name or a rule: obs64, chrome | *YouTube*, steam_app_*" />
								<Button Grid.Column="1" Content="Add" Command="{Binding AddAppCommand}" />
							</Grid>
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Grid>
		<ScrollViewer Grid.Row="1" Margin="20" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsDefaultSection}">
			<StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="14">
					<Border Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="section" Text="DEFAULT BACKGROUND FOR ALL PROFILES" />
							<local:BackgroundPreviewView DataContext="{Binding DefaultPreview}" />
							<TextBlock Classes="hint" Text="Used by every profile that does not use a background of its own. Set it once here; a profile can override it (Profiles, Background of this profile)." />
							<TextBlock Text="Color" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
							<local:ColorField Hex="{Binding DefaultBackgroundColor, Mode=TwoWay}" DefaultHex="#0B1220" Placeholder="DeckHost dark blue" Width="280" HorizontalAlignment="Left" />
							<TextBlock Text="{Binding DefaultBackgroundColorError}" IsVisible="{Binding HasDefaultBackgroundColorError}" Foreground="{DynamicResource C.FCA5A5}" FontSize="12" />
							<TextBlock Text="Image (PNG, JPG, SVG or animated GIF)" FontWeight="SemiBold" Foreground="{DynamicResource C.E2E8F0}" />
							<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
								<TextBox Text="{Binding DefaultBackgroundImage, Mode=TwoWay}" PlaceholderText="Optional image file" />
								<Button Grid.Column="1" Content="Browse…" Click="BrowseDefaultBackground_OnClick" />
								<Button Grid.Column="2" Content="Clear" Command="{Binding ClearDefaultBackgroundCommand}" />
							</Grid>
							<local:BackgroundLayersEditor DataContext="{Binding DefaultLayers}" Margin="0,6,0,0" />
						</StackPanel>
					</Border>

			</StackPanel>
		</ScrollViewer>
		<ScrollViewer Grid.Row="1" Margin="20" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsBackupsSection}">
			<StackPanel MaxWidth="900" HorizontalAlignment="Left" Spacing="14">
					<!-- Backups of all profiles: one a day (14 kept), or now; restore one. -->
					<Border Classes="card">
						<StackPanel Spacing="10">
							<TextBlock Classes="section" Text="BACKUPS" />
							<TextBlock Classes="hint" Text="DeckHost backs up all profiles once a day (the last 14 days are kept). Restoring replaces all profiles; the current ones are backed up first." />
							<StackPanel Orientation="Horizontal" Spacing="8">
								<Button Content="Back up now" Command="{Binding BackUpNowCommand}" />
								<TextBlock Text="{Binding Message}" Foreground="{DynamicResource C.93C5FD}" VerticalAlignment="Center" TextWrapping="Wrap" />
							</StackPanel>
							<ItemsControl ItemsSource="{Binding Backups}">
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:BackupItemViewModel">
										<Grid ColumnDefinitions="*,Auto" Margin="0,2">
											<TextBlock Text="{Binding Label}" Foreground="{DynamicResource C.CBD5E1}" VerticalAlignment="Center" />
											<Button Grid.Column="1" Content="Restore" Command="{Binding RestoreCommand}" />
										</Grid>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</StackPanel>
					</Border>

			</StackPanel>
		</ScrollViewer>
	</Grid>
</UserControl>
