<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		x:Class="DeckHost.App.Views.DeviceManagerView"
		x:DataType="vm:DeviceManagerViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="20" Spacing="14">
			<StackPanel Spacing="4">
				<TextBlock Text="Devices" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" />
				<TextBlock Classes="hint" Text="The devices DeckHost lists in the header, plugged in or not. Remove one you no longer use; its profiles are kept for when you add it again." />
				<ToggleSwitch IsChecked="{Binding AutoAdd}" OnContent="Add new devices by themselves when they are plugged in" OffContent="Add new devices by themselves when they are plugged in" Margin="0,6,0,0" />
				<TextBlock Classes="hint" Text="When this is off, a new device waits under Found until you add it." />
			</StackPanel>

			<Border Classes="card" IsVisible="{Binding HasDiscovered}" BorderBrush="{DynamicResource C.1D4ED8}">
				<StackPanel Spacing="8">
					<TextBlock Classes="section" Text="FOUND" />
					<ItemsControl ItemsSource="{Binding Discovered}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:DeviceRowViewModel">
								<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4">
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding Name}" Foreground="{DynamicResource C.E2E8F0}" />
										<TextBlock Classes="hint" Text="{Binding Detail}" />
									</StackPanel>
									<Button Grid.Column="1" Content="Add" Classes="accent" Command="{Binding AddCommand}" />
									<Button Grid.Column="2" Content="Keep ignoring" Command="{Binding KeepIgnoringCommand}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<Border Classes="card">
				<StackPanel Spacing="8">
					<TextBlock Classes="section" Text="YOUR DEVICES" />
					<ItemsControl ItemsSource="{Binding Listed}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:DeviceRowViewModel">
								<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,4">
									<Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{DynamicResource C.64748B}" Classes.on="{Binding IsConnected}">
										<Ellipse.Styles>
											<Style Selector="Ellipse.on">
												<Setter Property="Fill" Value="#22C55E" />
											</Style>
										</Ellipse.Styles>
									</Ellipse>
									<StackPanel Grid.Column="1" VerticalAlignment="Center">
										<TextBlock Text="{Binding Name}" Foreground="{DynamicResource C.E2E8F0}" />
										<TextBlock Classes="hint" Text="{Binding Detail}" />
									</StackPanel>
									<Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" ToolTip.Tip="{Binding RemoveTip}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>

			<Border Classes="card" IsVisible="{Binding HasIgnored}">
				<StackPanel Spacing="8">
					<TextBlock Classes="section" Text="REMOVED" />
					<TextBlock Classes="hint" Text="They stay out of the list. A removed device that is plugged in again shows up under Found." />
					<ItemsControl ItemsSource="{Binding Ignored}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:DeviceRowViewModel">
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,4">
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding Name}" Foreground="{DynamicResource C.E2E8F0}" />
										<TextBlock Classes="hint" Text="{Binding Detail}" />
									</StackPanel>
									<Button Grid.Column="1" Content="Add back" Command="{Binding AddCommand}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</UserControl>
