<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		x:Class="DeckHost.App.Views.WelcomeView"
		x:DataType="vm:WelcomeViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.hint">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>
		<Style Selector="TextBlock.heading">
			<Setter Property="FontSize" Value="22" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.F8FAFC}" />
			<Setter Property="AutomationProperties.HeadingLevel" Value="1" />
			<Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
		</Style>
		<Style Selector="TextBlock.subheading">
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.E2E8F0}" />
			<Setter Property="AutomationProperties.HeadingLevel" Value="2" />
		</Style>
		<Style Selector="TextBlock.status">
			<Setter Property="Foreground" Value="{DynamicResource C.93C5FD}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
		</Style>
		<Style Selector="TextBlock.dot">
			<Setter Property="Foreground" Value="{DynamicResource C.64748B}" />
		</Style>
		<Style Selector="TextBlock.dot.connected">
			<Setter Property="Foreground" Value="{DynamicResource C.BBF7D0}" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="16" />
		</Style>
		<Style Selector="Border.tip">
			<Setter Property="Background" Value="{DynamicResource C.111827}" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="12,10" />
		</Style>
		<Style Selector="Border.preview">
			<Setter Property="Background" Value="{DynamicResource C.1E293B}" />
			<Setter Property="CornerRadius" Value="8" />
			<Setter Property="Padding" Value="8,6" />
			<Setter Property="Width" Value="104" />
			<Setter Property="Height" Value="58" />
			<Setter Property="Margin" Value="0,0,6,6" />
		</Style>
	</UserControl.Styles>

	<Grid RowDefinitions="*,Auto" MaxWidth="760" Margin="20">
		<ScrollViewer HorizontalScrollBarVisibility="Disabled">
			<StackPanel Spacing="16">
				<!-- 1: welcome and devices -->
				<StackPanel Spacing="16" IsVisible="{Binding IsDevicesStep}">
					<StackPanel Orientation="Horizontal" Spacing="14">
						<Image Source="/Assets/deckhost-64.png" Width="56" Height="56" AutomationProperties.AccessibilityView="Raw" />
						<StackPanel VerticalAlignment="Center" Spacing="2">
							<TextBlock Classes="heading" Text="Welcome to DeckHost" />
							<TextBlock Classes="hint" Text="One platform. Unlimited control." />
						</StackPanel>
					</StackPanel>
					<TextBlock Classes="hint" Text="DeckHost drives your control surfaces: the MiraBox N4 Pro, Elgato Stream Decks, a Web Deck on your phone or tablet, and other USB button boxes, pedals and jog wheels you teach it. Each key, knob and touch zone runs what you put on it." />
					<Border Classes="card">
						<StackPanel Spacing="10">
							<Grid ColumnDefinitions="*,Auto">
								<TextBlock Classes="subheading" Text="Your devices" VerticalAlignment="Center" />
								<Button Grid.Column="1" Content="Look again" Command="{Binding RefreshDevicesCommand}" />
							</Grid>
							<TextBlock Classes="status" Text="{Binding FoundMessage}" IsVisible="{Binding HasFoundMessage}" Foreground="{DynamicResource C.BBF7D0}" FontWeight="SemiBold" />
							<TextBlock Classes="hint" Text="No devices found yet." IsVisible="{Binding !HasDevices}" />
							<ItemsControl ItemsSource="{Binding Devices}">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><StackPanel Spacing="6" /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:WelcomeDevice">
										<StackPanel Orientation="Horizontal" Spacing="10" AutomationProperties.Name="{Binding AccessibleName}">
											<TextBlock Classes="dot" Classes.connected="{Binding IsConnected}" Text="{Binding Dot}" VerticalAlignment="Center" />
											<TextBlock Text="{Binding Name}" Foreground="{DynamicResource C.E2E8F0}" VerticalAlignment="Center" />
											<TextBlock Text="{Binding State}" Foreground="{DynamicResource C.64748B}" VerticalAlignment="Center" />
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<Border Classes="tip" IsVisible="{Binding ShowNoDeviceHelp}">
								<StackPanel Spacing="8">
									<TextBlock Classes="subheading" Text="No device connected yet" Foreground="{DynamicResource C.FDE68A}" />
									<TextBlock Classes="hint" Text="{Binding DeviceHelp}" AutomationProperties.LiveSetting="Polite" />
									<Border IsVisible="{Binding HasHelpCommands}" Background="{DynamicResource C.0B1120}" CornerRadius="8" Padding="10,8">
										<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
											<SelectableTextBlock Text="{Binding HelpCommands}" FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
											<Button Grid.Column="1" Content="Copy" VerticalAlignment="Top" Click="CopyCommands_OnClick" AutomationProperties.Name="Copy the commands" />
										</Grid>
									</Border>
									<StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasHelpDocs}">
										<Button Content="Show the steps in the documentation" Command="{Binding OpenHelpDocsCommand}" />
										<TextBlock Classes="status" Text="{Binding CommandsStatus}" VerticalAlignment="Center" />
									</StackPanel>
									<TextBlock Classes="hint" Text="No device at hand? You can still try DeckHost:" Margin="0,4,0,0" />
									<WrapPanel>
										<Button Content="Open a deck on this screen" Command="{Binding OpenDesktopDeckCommand}" Margin="0,0,8,8" ToolTip.Tip="A window with the Web Deck's keys, on top of other windows." />
										<Button Content="Use my phone" Command="{Binding UsePhoneCommand}" Margin="0,0,8,8" ToolTip.Tip="Shares the Web Deck with phones on this network and opens a QR code to scan." />
										<Button Content="Try the simulator" Command="{Binding TrySimulatorCommand}" Margin="0,0,8,8" ToolTip.Tip="A window that looks and works like a real device (an N4 Pro, a Stream Deck, …)." />
									</WrapPanel>
									<TextBlock Classes="status" Text="{Binding NoDeviceStatus}" IsVisible="{Binding HasNoDeviceStatus}" />
									<TextBlock Classes="hint" Text="You can set everything up without a device; it shows up as soon as you plug it in." />
								</StackPanel>
							</Border>
						</StackPanel>
					</Border>
					<Border Classes="card">
						<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
							<StackPanel Spacing="4">
								<TextBlock Classes="subheading" Text="Another USB device?" />
								<TextBlock Classes="hint" Text="A button box, foot pedal, jog wheel or game controller can become a deck too: press each key and turn each knob once so DeckHost learns them, place them as they sit, and save." />
							</StackPanel>
							<Button Grid.Column="1" Content="Add a USB device" VerticalAlignment="Center" Command="{Binding AddUsbDeviceCommand}" />
						</Grid>
					</Border>
				</StackPanel>

				<!-- 2: a starting point -->
				<StackPanel Spacing="16" IsVisible="{Binding IsStartStep}">
					<TextBlock Classes="heading" Text="Start with something useful" />
					<TextBlock Classes="hint" Text="Fill the empty keys of this profile with everyday actions, or start empty and drag actions from the list on the right yourself." />
					<Border Classes="card">
						<StackPanel Spacing="10">
							<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
								<TextBlock Classes="subheading" Text="Starter layout" VerticalAlignment="Center" />
								<ComboBox Grid.Column="1" ItemsSource="{Binding Starters}" SelectedItem="{Binding SelectedStarter}" MinWidth="160" AutomationProperties.Name="Starter layout" />
							</Grid>
							<TextBlock Classes="hint" Text="{Binding StarterDescription}" />
							<TextBlock Classes="hint" Text="{Binding StarterNote}" IsVisible="{Binding HasStarterNote}" Foreground="{DynamicResource C.FDE68A}" />
							<ItemsControl ItemsSource="{Binding StarterPreview}" IsVisible="{Binding HasStarterPreview}" AutomationProperties.Name="What the starter puts on the device">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate x:DataType="vm:StarterPreviewItem">
										<Border Classes="preview" ToolTip.Tip="{Binding ControlName}">
											<StackPanel VerticalAlignment="Center" Spacing="2">
												<TextBlock Text="{Binding ActionName}" Foreground="{DynamicResource C.F1F5F9}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
												<TextBlock Text="{Binding ControlName}" Foreground="{DynamicResource C.94A3B8}" FontSize="10" TextTrimming="CharacterEllipsis" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
							<TextBlock Classes="hint" Text="Every control already has an action: nothing would change." IsVisible="{Binding StarterFillsNothing}" />
							<TextBlock Classes="hint" Text="Controls that already have an action keep it." />
							<Button Content="{Binding ApplyStarterLabel}" Classes="accent" Command="{Binding ApplyStarterCommand}" IsEnabled="{Binding CanApplyStarter}" HorizontalAlignment="Left" />
							<TextBlock Classes="status" Text="{Binding StarterStatus}" />
						</StackPanel>
					</Border>
					<Border Classes="card">
						<StackPanel Spacing="8">
							<TextBlock Classes="subheading" Text="Coming from the Stream Deck app?" />
							<TextBlock Classes="hint" Text="Bring your .streamDeckProfile files along: the keys and dials land where they were. Install your Stream Deck plugins from Plugins → Store." />
							<Button Content="Import a Stream Deck profile…" Click="ImportProfile_OnClick" IsEnabled="{Binding CanImport}" HorizontalAlignment="Left" />
							<TextBlock Classes="status" Text="{Binding ImportStatus}" />
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- 3: preferences -->
				<StackPanel Spacing="16" IsVisible="{Binding IsPreferencesStep}">
					<TextBlock Classes="heading" Text="A few preferences" />
					<Border Classes="card">
						<StackPanel Spacing="12">
							<StackPanel Spacing="2">
								<CheckBox Content="Start DeckHost when I sign in" IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding CanStartAtLogin}" />
								<TextBlock Classes="hint" Margin="28,0,0,0" Text="Your device works right after sign-in; DeckHost waits in the tray." />
							</StackPanel>
							<StackPanel Spacing="2">
								<CheckBox Content="Closing the window keeps DeckHost running in the tray" IsChecked="{Binding KeepRunningInTray}" />
								<TextBlock Classes="hint" Margin="28,0,0,0" Text="{Binding TrayHint}" />
							</StackPanel>
							<StackPanel Spacing="2">
								<CheckBox Content="Check for DeckHost updates" IsChecked="{Binding CheckForUpdates}" />
								<TextBlock Classes="hint" Margin="28,0,0,0" Text="Asks GitHub for new releases now and then. Updates are only installed when you choose to." />
							</StackPanel>
							<StackPanel Orientation="Horizontal" Spacing="10">
								<TextBlock Text="Look" VerticalAlignment="Center" Foreground="{DynamicResource C.E2E8F0}" />
								<ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" MinWidth="200" AutomationProperties.Name="Look" />
							</StackPanel>
							<StackPanel Spacing="2">
								<CheckBox Content="After a crash, offer to report it" IsChecked="{Binding OfferCrashReports}" />
								<TextBlock Classes="hint" Margin="28,0,0,0" Text="A crash report is kept on this computer. On the next start DeckHost asks whether you want to report it; nothing is ever sent by itself." />
							</StackPanel>
						</StackPanel>
					</Border>
				</StackPanel>

				<!-- 4: how it works -->
				<StackPanel Spacing="12" IsVisible="{Binding IsTipsStep}">
					<TextBlock Classes="heading" Text="How DeckHost works" />
					<Border Classes="tip"><TextBlock Classes="hint" Text="Drag an action from the list on the right onto a key, knob or touch zone; drag it off to remove it." /></Border>
					<Border Classes="tip"><TextBlock Classes="hint" Text="Click a control to set it up below the device. Double-click it to try it. Ctrl+Z undoes." /></Border>
					<Border Classes="tip"><TextBlock Classes="hint" Text="Profiles switch the whole device, pages flip with a swipe, folders open a set of keys." /></Border>
					<Border Classes="tip"><TextBlock Classes="hint" Text="More actions are in Plugins → Store; help is in the ☰ menu." /></Border>
					<Button Content="Open the documentation" Command="{Binding OpenDocumentationCommand}" HorizontalAlignment="Left" />
					<TextBlock Classes="status" Text="{Binding CommandsStatus}" IsVisible="{Binding IsTipsStep}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,16,0,0">
			<Button Content="Skip the tour" Command="{Binding FinishCommand}" />
			<TextBlock Grid.Column="1" Text="{Binding StepText}" Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
			<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
				<Button Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding CanGoBack}" />
				<Button x:Name="NextButton" Content="{Binding NextLabel}" Classes="accent" Command="{Binding NextCommand}" />
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
