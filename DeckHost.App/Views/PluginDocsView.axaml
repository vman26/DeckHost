<UserControl
		xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		xmlns:views="using:DeckHost.App.Views"
		x:Class="DeckHost.App.Views.PluginDocsView"
		x:DataType="vm:PluginDocsViewModel">

	<UserControl.Styles>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{DynamicResource C.94A3B8}" />
			<Setter Property="LetterSpacing" Value="0.5" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="{DynamicResource C.0F172A}" />
			<Setter Property="BorderBrush" Value="{DynamicResource C.1E293B}" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="16" />
		</Style>
	</UserControl.Styles>

	<ScrollViewer HorizontalScrollBarVisibility="Disabled">
		<StackPanel Margin="20" Spacing="14" MaxWidth="980" HorizontalAlignment="Stretch">
			<!-- Who and what -->
			<Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
				<Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource C.1E293B}" VerticalAlignment="Top" ClipToBounds="True">
					<Panel Margin="10">
						<Viewbox IsVisible="{Binding Icon.HasGeometry}">
							<Canvas Width="24" Height="24"><Path Data="{Binding Icon.Geometry}" Fill="{Binding Icon.Brush}" /></Canvas>
						</Viewbox>
						<Image Source="{Binding Icon.Image}" IsVisible="{Binding Icon.HasImage}" Stretch="Uniform" />
					</Panel>
				</Border>
				<StackPanel Grid.Column="1" Spacing="4">
					<TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource C.F8FAFC}" TextWrapping="Wrap" />
					<TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
					<TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" Margin="0,4,0,0" />
					<ItemsControl ItemsSource="{Binding Links}" IsVisible="{Binding HasLinks}" Margin="0,8,0,0">
						<ItemsControl.ItemsPanel>
							<ItemsPanelTemplate>
								<WrapPanel />
							</ItemsPanelTemplate>
						</ItemsControl.ItemsPanel>
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:PluginDocsLink">
								<Button Content="{Binding Label}" Margin="0,0,8,8" ToolTip.Tip="{Binding Url}"
										Command="{Binding $parent[UserControl].((vm:PluginDocsViewModel)DataContext).OpenLinkCommand}"
										CommandParameter="{Binding Url}" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</StackPanel>
			</Grid>

			<!-- Its actions -->
			<StackPanel Spacing="8" IsVisible="{Binding HasActions}">
				<TextBlock Classes="section" Text="{Binding ActionsTitle}" />
				<ItemsControl ItemsSource="{Binding Actions}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="6" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:PluginDocsAction">
							<Border Classes="card" Padding="12,10">
								<Grid ColumnDefinitions="24,*" ColumnSpacing="12">
									<Panel Width="24" Height="24" VerticalAlignment="Top">
										<Viewbox IsVisible="{Binding Icon.HasGeometry}">
											<Canvas Width="24" Height="24"><Path Data="{Binding Icon.Geometry}" Fill="{Binding Icon.Brush}" /></Canvas>
										</Viewbox>
										<Image Source="{Binding Icon.Image}" IsVisible="{Binding Icon.HasImage}" Stretch="Uniform" />
									</Panel>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource C.F1F5F9}" />
										<TextBlock Text="{Binding Description}" Foreground="{DynamicResource C.CBD5E1}" TextWrapping="Wrap" />
										<TextBlock Text="{Binding Works}" FontSize="11" Foreground="{DynamicResource C.64748B}" TextWrapping="Wrap" />
									</StackPanel>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>

			<!-- Its README -->
			<StackPanel Spacing="8">
				<StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasReadmeStatus}">
					<TextBlock Text="{Binding ReadmeStatus}" FontSize="12" Foreground="{DynamicResource C.94A3B8}" TextWrapping="Wrap" />
				</StackPanel>
				<Border Classes="card" IsVisible="{Binding HasReadme}">
					<views:MarkdownView Markdown="{Binding ReadmeMarkdown}"
										ImageBase="{Binding ReadmeImageBase}"
										LinkBase="{Binding ReadmeLinkBase}"
										ImageLoader="{Binding ImageLoader}" />
				</Border>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
