<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:DeckHost.App.ViewModels"
		x:Class="DeckHost.App.Views.PluginManagerWindow"
		x:DataType="vm:PluginManagerViewModel"
		Width="820"
		Height="760"
		MinWidth="640"
		MinHeight="520"
		Background="#111827"
		RequestedThemeVariant="Dark"
		Icon="/Assets/avalonia-logo.ico"
		Title="Plugin Manager">

	<Window.Styles>
		<Style Selector="TextBlock.section">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="#94A3B8" />
			<Setter Property="LetterSpacing" Value="0.5" />
		</Style>
		<Style Selector="Border.card">
			<Setter Property="Background" Value="#0F172A" />
			<Setter Property="BorderBrush" Value="#1E293B" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="CornerRadius" Value="12" />
			<Setter Property="Padding" Value="14" />
		</Style>
		<Style Selector="Border.badge">
			<Setter Property="CornerRadius" Value="999" />
			<Setter Property="Padding" Value="8,2" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
	</Window.Styles>

	<Window.DataTemplates>
		<DataTemplate DataType="vm:PluginEntryViewModel">
			<Border Classes="card">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
					<StackPanel Spacing="4">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
							<TextBlock Text="{Binding Version}" Foreground="#64748B" VerticalAlignment="Center" />
							<Border Classes="badge" Background="#1E3A8A" IsVisible="{Binding IsSystem}">
								<TextBlock Text="System" FontSize="11" Foreground="#BFDBFE" />
							</Border>
						</StackPanel>
						<TextBlock Text="{Binding Details}" FontSize="12" Foreground="#94A3B8" />
						<TextBlock Text="{Binding Description}" IsVisible="{Binding HasDescription}" Foreground="#CBD5E1" TextWrapping="Wrap" />
						<TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="#FCA5A5" TextWrapping="Wrap" />
						<TextBlock Text="{Binding Id}" FontSize="11" Foreground="#475569" />
					</StackPanel>
					<StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Right">
						<ToggleSwitch IsChecked="{Binding IsEnabled}"
									  IsVisible="{Binding CanToggle}"
									  OnContent="Enabled"
									  OffContent="Disabled" />
						<Border Classes="badge" Background="#1E293B" IsVisible="{Binding IsLocked}" HorizontalAlignment="Right">
							<TextBlock Text="{Binding LockedReason}" FontSize="11" Foreground="#94A3B8" />
						</Border>
						<Button Content="Uninstall"
								IsVisible="{Binding CanUninstall}"
								HorizontalAlignment="Right"
								Command="{Binding UninstallCommand}" />
					</StackPanel>
				</Grid>
			</Border>
		</DataTemplate>
	</Window.DataTemplates>

	<Grid RowDefinitions="Auto,*">
		<Border Padding="20,16"
				Background="#0F172A"
				BorderBrush="#1E293B"
				BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
				<StackPanel Spacing="4">
					<TextBlock Text="Plugin Manager" FontSize="24" FontWeight="SemiBold" Foreground="#F8FAFC" />
					<TextBlock Text="System plugins ship with DeckHost and can be switched off. Installed plugins can also be removed."
							   Foreground="#94A3B8"
							   TextWrapping="Wrap" />
				</StackPanel>
				<Button Grid.Column="1"
						Classes="accent"
						VerticalAlignment="Center"
						Content="Install plugin…"
						Click="InstallPlugin_OnClick" />
				<Border Grid.Row="1"
						Grid.ColumnSpan="2"
						Padding="10,6"
						CornerRadius="8"
						Background="#1E293B"
						IsVisible="{Binding HasStatus}">
					<TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="#E2E8F0" />
				</Border>
			</Grid>
		</Border>

		<ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
			<StackPanel Margin="20" Spacing="12">
				<TextBlock Classes="section" Text="DEVICES" />
				<ItemsControl ItemsSource="{Binding Devices}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:DeviceInfoViewModel">
							<Border Classes="card" Margin="0,0,0,8">
								<StackPanel Spacing="4">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Foreground="#F8FAFC" />
										<Border Classes="badge" Background="#14532D" IsVisible="{Binding IsConnected}">
											<TextBlock Text="{Binding State}" FontSize="11" Foreground="#BBF7D0" />
										</Border>
										<Border Classes="badge" Background="#1E293B" IsVisible="{Binding !IsConnected}">
											<TextBlock Text="{Binding State}" FontSize="11" Foreground="#94A3B8" />
										</Border>
									</StackPanel>
									<TextBlock Text="{Binding Detail}" Foreground="#CBD5E1" TextWrapping="Wrap" />
									<TextBlock Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
											   Text="Firmware updates: the StreamDock SDK can read the firmware version but has no update function, so DeckHost can't check for or install firmware. Use MiraBox's own Stream Dock software to update, then reconnect the device here." />
								</StackPanel>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Classes="section" Text="SYSTEM PLUGINS" Margin="0,8,0,0" />
				<ItemsControl ItemsSource="{Binding SystemPlugins}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="8" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>

				<TextBlock Classes="section" Text="INSTALLED PLUGINS" Margin="0,8,0,0" />
				<Border Classes="card" IsVisible="{Binding HasNoInstalledPlugins}">
					<StackPanel Spacing="4">
						<TextBlock Text="No plugins installed yet." FontWeight="SemiBold" Foreground="#E2E8F0" />
						<TextBlock Foreground="#94A3B8" TextWrapping="Wrap"
								   Text="Use Install plugin… to add a plugin package (.zip). Plugins run with your user's rights, so only install packages you trust." />
					</StackPanel>
				</Border>
				<ItemsControl ItemsSource="{Binding InstalledPlugins}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Spacing="8" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
				</ItemsControl>
				<TextBlock FontSize="11" Foreground="#475569" TextWrapping="Wrap">
					<Run Text="Installed plugins live in " />
					<Run Text="{Binding InstallDirectory}" />
				</TextBlock>
			</StackPanel>
		</ScrollViewer>
	</Grid>
</Window>
