<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <IsWindows>$([MSBuild]::IsOsPlatform('Windows'))</IsWindows>
    <IsLinux>$([MSBuild]::IsOsPlatform('Linux'))</IsLinux>
    <IsMacOS>$([MSBuild]::IsOsPlatform('OSX'))</IsMacOS>
    <MiraBoxNativeRuntimeDir>$(MSBuildProjectDirectory)/../native/MiraBoxBridge/out/$(Configuration)/bin/$(Configuration)</MiraBoxNativeRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Native binaries that older builds copied into the source tree; never compile or ship them from here. -->
    <None Remove="Plugins\device\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
    <ProjectReference Include="..\DeckHost.Core\DeckHost.Core.csproj" />
    <ProjectReference Include="..\DeckHost.Device.MiraBox\DeckHost.Device.MiraBox.csproj" />
  </ItemGroup>

  <Target Name="PreparePluginDirectories"
          BeforeTargets="CopyFilesToOutputDirectory">
    <MakeDir Directories="$(OutDir)plugins\;$(OutDir)plugins\device\;$(OutDir)plugins\functional\;$(OutDir)plugins\device\deckhost.device.mirabox\" />
  </Target>

  <!-- MiraBoxNative resolves MiraBoxBridge only from plugins/device/deckhost.device.mirabox. -->
  <Target Name="CopyMiraBoxBridgeRuntimeToPluginOutput"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="Exists('$(MiraBoxNativeRuntimeDir)')">
    <ItemGroup>
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.dll" Condition="'$(IsWindows)' == 'true'" />
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.pdb" Condition="'$(IsWindows)' == 'true' and '$(Configuration)' == 'Debug'" />
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.so" Condition="'$(IsLinux)' == 'true'" />
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.dylib" Condition="'$(IsMacOS)' == 'true'" />
    </ItemGroup>

    <!-- Plain copies: hard links would let a later native rebuild silently change files elsewhere. -->
    <Copy SourceFiles="@(MiraBoxNativeArtifacts)"
          DestinationFolder="$(OutDir)plugins\device\deckhost.device.mirabox\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
