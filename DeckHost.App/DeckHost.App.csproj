<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deckhost.ico</ApplicationIcon>
    <!-- LibraryImport (Platform/MacNative) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsWindows>$([MSBuild]::IsOsPlatform('Windows'))</IsWindows>
    <IsLinux>$([MSBuild]::IsOsPlatform('Linux'))</IsLinux>
    <IsMacOS>$([MSBuild]::IsOsPlatform('OSX'))</IsMacOS>
    <!-- The GitHub repository (owner/name) the updater checks for releases. The release workflow
         sets it to the public releases repository when the source repository is private. -->
    <DeckHostUpdateRepository Condition="'$(DeckHostUpdateRepository)' == ''">vman26/DeckHost</DeckHostUpdateRepository>
    <!-- DeckHost runs all day and is mostly idle: published builds are precompiled (ReadyToRun) and
         skip .NET's profile-guided re-optimization, so it doesn't spend CPU compiling hot code again
         in its first minutes; the peak speed that buys isn't needed here (docs/performance.md). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(DeckHostUpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- What's new after an update (ViewModels/WhatsNewViewModel) reads the version's section. -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="DeckHost.CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeckHost.Tests" />
    <InternalsVisibleTo Include="DeckHost.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- PrivateAssets: the tests reference this project; WebView2 (and its WPF wrapper) stays here. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" PrivateAssets="all" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Avalonia brings an older native Skia for Linux; DeckHost.Core uses SkiaSharp 4.151, which needs
         its own. (Windows and macOS get it from SkiaSharp itself.) -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
    <ProjectReference Include="..\DeckHost.Core\DeckHost.Core.csproj" />
    <!-- Bundled device plugins: built first, shipped as packages under plugins/bundled (not referenced by the app). -->
    <ProjectReference Include="..\DeckHost.Device.Elgato\DeckHost.Device.Elgato.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DeckHost.Device.Hid\DeckHost.Device.Hid.csproj" />
    <ProjectReference Include="..\DeckHost.Device.MiraBox\DeckHost.Device.MiraBox.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\DeckHost.Device.Simulator\DeckHost.Device.Simulator.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Web\DeckHost.Device.Web.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Only WebView2's Core API is used (Views/WebView2Host); drop its WPF and WinForms wrappers. -->
  <Target Name="RemoveWebView2UiFrameworkReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <Target Name="PreparePluginDirectories" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(OutDir)' != '' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(OutDir)plugins\;$(OutDir)plugins\bundled\;$(OutDir)plugins\functional\" />
  </Target>

  <!-- The device plugins that ship with DeckHost: artifacts/bundled/<folder> (staged by build/BundledDevicePlugin.targets) -> plugins/bundled/<folder>. -->
  <Target Name="CopyBundledPluginsToOutput" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(OutDir)' != '' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <BundledPluginFile Include="$(MSBuildProjectDirectory)\..\artifacts\bundled\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(BundledPluginFile)" DestinationFiles="@(BundledPluginFile->'$(OutDir)plugins\bundled\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishBundledPlugins" AfterTargets="Publish" Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <BundledPluginPublish Include="$(MSBuildProjectDirectory)\..\artifacts\bundled\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins/functional" />
    <Copy SourceFiles="@(BundledPluginPublish)" DestinationFiles="@(BundledPluginPublish->'$(PublishDir)plugins\bundled\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

</Project>
