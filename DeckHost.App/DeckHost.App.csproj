<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\deckhost.ico</ApplicationIcon>
    <!-- LibraryImport (Platform/MacNative) generates unsafe marshalling code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsWindows>$([MSBuild]::IsOsPlatform('Windows'))</IsWindows>
    <IsLinux>$([MSBuild]::IsOsPlatform('Linux'))</IsLinux>
    <IsMacOS>$([MSBuild]::IsOsPlatform('OSX'))</IsMacOS>
    <MiraBoxNativeRuntimeDir>$(MSBuildProjectDirectory)/../native/MiraBoxBridge/out/$(Configuration)/bin/$(Configuration)</MiraBoxNativeRuntimeDir>
    <!-- The GitHub repository (owner/name) the updater checks for releases. The release workflow
         sets it to the public releases repository when the source repository is private. -->
    <DeckHostUpdateRepository Condition="'$(DeckHostUpdateRepository)' == ''">vman26/DeckHost</DeckHostUpdateRepository>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepository" Value="$(DeckHostUpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DeckHost.Tests" />
    <InternalsVisibleTo Include="DeckHost.UiTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <!-- PrivateAssets: the tests reference this project; WebView2 (and its WPF wrapper) stays here. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" PrivateAssets="all" />
    <PackageReference Include="NLog" Version="6.2.2" />
    <!-- Avalonia brings an older native Skia for Linux; DeckHost.Core uses SkiaSharp 4.151, which needs
         its own. (Windows and macOS get it from SkiaSharp itself.) -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeckHost.Contracts\DeckHost.Contracts.csproj" />
    <ProjectReference Include="..\DeckHost.Core\DeckHost.Core.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Elgato\DeckHost.Device.Elgato.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Hid\DeckHost.Device.Hid.csproj" />
    <ProjectReference Include="..\DeckHost.Device.MiraBox\DeckHost.Device.MiraBox.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Simulator\DeckHost.Device.Simulator.csproj" />
    <ProjectReference Include="..\DeckHost.Device.Web\DeckHost.Device.Web.csproj" />
  </ItemGroup>

  <!-- Only WebView2's Core API is used (Views/WebView2Host); drop its WPF and WinForms wrappers. -->
  <Target Name="RemoveWebView2UiFrameworkReferences" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' or '%(Filename)' == 'Microsoft.Web.WebView2.WinForms'" />
    </ItemGroup>
  </Target>

  <Target Name="PreparePluginDirectories" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(OutDir)' != '' and '$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(OutDir)plugins\;$(OutDir)plugins\device\;$(OutDir)plugins\functional\;$(OutDir)plugins\device\deckhost-device-mirabox\" />
  </Target>

  <!-- MiraBoxNative resolves MiraBoxBridge only from plugins/device/deckhost-device-mirabox. -->
  <Target Name="CopyMiraBoxBridgeRuntimeToPluginOutput" BeforeTargets="CopyFilesToOutputDirectory" Condition="'$(OutDir)' != '' and '$(DesignTimeBuild)' != 'true' and Exists('$(MiraBoxNativeRuntimeDir)')">
    <ItemGroup>
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.dll" Condition="'$(IsWindows)' == 'true'" />
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.pdb" Condition="'$(IsWindows)' == 'true' and '$(Configuration)' == 'Debug'" />
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.so" Condition="'$(IsLinux)' == 'true'" />
      <MiraBoxNativeArtifacts Include="$(MiraBoxNativeRuntimeDir)/*.dylib" Condition="'$(IsMacOS)' == 'true'" />
    </ItemGroup>

    <!-- Plain copies: hard links would let a later native rebuild silently change files elsewhere. -->
    <Copy SourceFiles="@(MiraBoxNativeArtifacts)" DestinationFolder="$(OutDir)plugins\device\deckhost-device-mirabox\" SkipUnchangedFiles="true" />
  </Target>

  <!-- dotnet publish: the same native files, in the same place next to the published app. -->
  <Target Name="PublishMiraBoxBridgeRuntime" AfterTargets="Publish" Condition="'$(PublishDir)' != '' and Exists('$(MiraBoxNativeRuntimeDir)')">
    <ItemGroup>
      <MiraBoxNativePublish Include="$(MiraBoxNativeRuntimeDir)/*.dll" Condition="'$(IsWindows)' == 'true'" />
      <MiraBoxNativePublish Include="$(MiraBoxNativeRuntimeDir)/*.so" Condition="'$(IsLinux)' == 'true'" />
      <MiraBoxNativePublish Include="$(MiraBoxNativeRuntimeDir)/*.dylib" Condition="'$(IsMacOS)' == 'true'" />
    </ItemGroup>
    <MakeDir Directories="$(PublishDir)plugins/device/deckhost-device-mirabox;$(PublishDir)plugins/functional" />
    <Copy SourceFiles="@(MiraBoxNativePublish)" DestinationFolder="$(PublishDir)plugins/device/deckhost-device-mirabox/" />
  </Target>
</Project>
