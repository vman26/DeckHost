<Project>
  <!--
    Imported by a DeckHost.Device.* project that ships with DeckHost as a plugin package (docs/maintainers/device-plugins.md).
    The project sets BundledPluginId (its plugin.json id, also the folder name) and has a plugin.json next to it.
    After each build the plugin's folder (plugin.json, the assembly and its managed dependencies) is staged in
    artifacts/bundled/<id>; DeckHost.App copies artifacts/bundled to plugins/bundled next to the app.
    DeckHost.Contracts and SkiaSharp are left out: they come from the host.
  -->
  <PropertyGroup>
    <BundledPluginsDirectory Condition="'$(BundledPluginsDirectory)' == ''">$(MSBuildThisFileDirectory)..\artifacts\bundled\</BundledPluginsDirectory>
  </PropertyGroup>

  <Target Name="BundleDevicePlugin" AfterTargets="Build" Condition="'$(BundledPluginId)' != '' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BundledPluginFolder>$(BundledPluginsDirectory)$(BundledPluginId)\</BundledPluginFolder>
    </PropertyGroup>
    <ItemGroup>
      <BundledDependency Include="@(ReferenceCopyLocalPaths)" Condition="'%(Extension)' == '.dll'" />
      <BundledDependency Remove="@(BundledDependency)" Condition="'%(Filename)' == 'DeckHost.Contracts' or '%(Filename)' == 'SkiaSharp' or '%(Filename)' == 'libSkiaSharp'" />
    </ItemGroup>
    <RemoveDir Directories="$(BundledPluginFolder)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\plugin.json" DestinationFolder="$(BundledPluginFolder)" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(BundledPluginFolder)" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
    <Copy SourceFiles="@(BundledDependency)" DestinationFolder="$(BundledPluginFolder)" />
  </Target>
</Project>
