<Project>
  <!-- Shared by every project in the repository. -->
  <PropertyGroup>
    <Product>DeckHost</Product>
    <Authors>Marco Veltman</Authors>
    <Copyright>Copyright (c) 2026 Marco Veltman and DeckHost contributors</Copyright>
    <!-- GPL-3.0-or-later with a plugin exception (NOTICE.md); DeckHost.Contracts overrides this with MIT. -->
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>

    <!-- Versions come from git (GitVersion, rules in GitVersion.yml): tags are releases, and the
         branch you work on decides what comes next (develop: next minor, hotfix/*: next patch,
         release/1.4.0: 1.4.0). Needs the full history, not a shallow clone. Without a git checkout
         (a source archive) the version stays 1.0.0. CI computes the version once
         (scripts/version.sh) and passes it in with DisableGitVersionTask. -->
    <DisableGitVersionTask Condition="'$(DisableGitVersionTask)' == '' and !Exists('$(MSBuildThisFileDirectory).git')">true</DisableGitVersionTask>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GitVersion.MsBuild" Version="6.8.2" PrivateAssets="all" />
  </ItemGroup>
</Project>
